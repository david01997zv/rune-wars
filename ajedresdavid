class LobbyAnfitrion:  # Define una clase (plantilla para crear objetos)
    """
    Pantalla de espera para el jugador que actúa como servidor (anfitrión).

    Muestra:
        - IP local y puerto de escucha.
        - Estado de la sala (esperando / sala llena).
        - Log de eventos del servidor en tiempo real.
        - Botón «Cancelar» para volver al menú.

    Args:
        ventana         (pygame.Surface): Ventana principal.
        fuentes         (dict)          : Diccionario con fuentes cargadas.
        nombre_jugador  (str)           : Alias del anfitrión.
        puerto          (int)           : Puerto de escucha.
        tablero_logica                  : Instancia del Tablero del juego.
    """

    def __init__(  # Constructor: inicializa el objeto al crearlo
        self,
        ventana: pygame.Surface,
        fuentes: dict,
        nombre_jugador: str = "Anfitrión",
        puerto: int = 5555,
        tablero_logica=None,
    ):
        self._ventana         = ventana
        self._fuentes         = fuentes
        self._nombre          = nombre_jugador
        self._puerto          = puerto
        self._tablero_logica  = tablero_logica

        self._log: list[str]  = []
        self._log_lock        = threading.Lock()
        self._accion          = None           # se llena cuando termina la pantalla
        self._rival_nombre    = ""
        self._reloj           = pygame.time.Clock()

        # Servidor en hilo
        self._servidor = Servidor(
            puerto=self._puerto,
            tablero_logica=tablero_logica,
            en_callback_estado=self._callback_servidor,
        )
        self._servidor._nombre_anfitrion = nombre_jugador  # Nombre visible para el rival
        self._hilo_servidor = threading.Thread(
            target=self._servidor.iniciar, daemon=True
        )

        # Botones
        f_btn = fuentes.get("normal") or pygame.font.SysFont("Arial", 20)
        self._btn_cancelar = _Boton(
            pygame.Rect(_LOBBY_ANCHO // 2 - 90, _LOBBY_ALTO - 80, 180, 44),
            "Cancelar",
            f_btn,
        )

        # Determinar IP local
        self._ip_local = _obtener_ip_local()

    # --- Ciclo principal ---------------------------------------------------

    def ejecutar(self) -> str:  # Define una función o método
        """
        Bucle principal de la pantalla de lobby del anfitrión.

        Returns:
            str: ACCION_INICIAR_PARTIDA o ACCION_MENU.
        """
        self._agregar_log("Iniciando servidor…")
        self._hilo_servidor.start()
        self._agregar_log(f"Escuchando en {self._ip_local}:{self._puerto}")
        self._agregar_log("Esperando que se una un rival…")

        while self._accion is None:  # Repite el bloque mientras la condición sea verdadera
            self._reloj.tick(_LOBBY_FPS)
            for evento in pygame.event.get():  # Repite el bloque por cada elemento del iterable
                if evento.type == pygame.QUIT:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._accion = ACCION_MENU
                if self._btn_cancelar.fue_clicado(evento):  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._servidor.detener()
                    self._accion = ACCION_MENU

            self._dibujar()

        return self._accion  # Devuelve un valor y termina la función

    # --- Callback del servidor --------------------------------------------

    def _callback_servidor(self, evento: dict):  # Define una función o método
        """
        Recibe notificaciones del servidor y actualiza el log / acción.

        Args:
            evento (dict): Diccionario con clave "evento".
        """
        tipo = evento.get("evento")
        if tipo == "partida_iniciada":  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._agregar_log("¡Rival conectado! La partida comienza…")
            time.sleep(1.5)
            self._accion = ACCION_INICIAR_PARTIDA
        elif tipo == "desconexion":  # Condición alternativa si la anterior fue falsa
            jugador = evento.get("jugador", "?")
            self._agregar_log(f"Desconexión: {jugador}")
        elif tipo == "victoria":  # Condición alternativa si la anterior fue falsa
            ganador = evento.get("ganador", "?")
            self._agregar_log(f"Partida terminada. Ganador: {ganador}")

    # --- Log thread-safe --------------------------------------------------

    def _agregar_log(self, texto: str):  # Define una función o método
        """
        Agrega una línea al log de eventos del lobby.

        Args:
            texto (str): Línea a agregar.
        """
        with self._log_lock:  # Gestiona un recurso y lo cierra automáticamente al terminar
            self._log.append(texto)
            if len(self._log) > _LOBBY_MAX_MENSAJES_LOG:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._log.pop(0)

    # --- Renderizado -------------------------------------------------------

    def _dibujar(self):  # Define una función o método
        """Dibuja la pantalla completa del lobby del anfitrión."""
        ventana = self._ventana
        ventana.fill(_LOBBY_COLOR_FONDO)

        f_titulo  = self._fuentes.get("titulo")  or pygame.font.SysFont("Arial", 34, bold=True)
        f_grande  = self._fuentes.get("grande")  or pygame.font.SysFont("Arial", 24)
        f_normal  = self._fuentes.get("normal")  or pygame.font.SysFont("Arial", 20)
        f_pequena = self._fuentes.get("pequeña") or pygame.font.SysFont("Arial", 16)

        # Título
        _dibujar_texto_centrado(ventana, "⚔  Rune Wars — Sala del Anfitrión  ⚔",
                                f_titulo, _LOBBY_COLOR_TITULO, _LOBBY_ANCHO // 2, 50)

        # Panel central
        panel = pygame.Rect(_LOBBY_MARGEN, 90, _LOBBY_ANCHO - _LOBBY_MARGEN * 2, 420)
        pygame.draw.rect(ventana, _LOBBY_COLOR_PANEL, panel, border_radius=12)
        pygame.draw.rect(ventana, _LOBBY_COLOR_BORDE, panel, 2, border_radius=12)

        # IP y puerto
        _dibujar_texto_centrado(ventana, "Comparte estos datos con tu rival:",
                                f_normal, _LOBBY_COLOR_TEXTO_DIM, _LOBBY_ANCHO // 2, 115)
        _dibujar_texto_centrado(ventana, f"IP: {self._ip_local}",
                                f_grande, _LOBBY_COLOR_SECCION, _LOBBY_ANCHO // 2, 150)
        _dibujar_texto_centrado(ventana, f"Puerto: {self._puerto}",
                                f_grande, _LOBBY_COLOR_SECCION, _LOBBY_ANCHO // 2, 185)

        # Separador
        pygame.draw.line(ventana, _LOBBY_COLOR_SEPARADOR,
                         (_LOBBY_MARGEN + 20, 220), (_LOBBY_ANCHO - _LOBBY_MARGEN - 20, 220), 1)

        # Indicador de estado animado
        pulso = abs((time.time() % 2) - 1)   # 0.0 → 1.0 → 0.0
        r = int(60 + 120 * pulso)
        color_pulso = (r, 180, 140)
        _dibujar_texto_centrado(ventana, "● Esperando rival…",
                                f_normal, color_pulso, _LOBBY_ANCHO // 2, 245)

        # Log de eventos
        _dibujar_texto_centrado(ventana, "Registro de eventos:",
                                f_pequena, _LOBBY_COLOR_TEXTO_DIM, _LOBBY_ANCHO // 2, 280)
        with self._log_lock:  # Gestiona un recurso y lo cierra automáticamente al terminar
            log_snapshot = list(self._log)

        y_log = 305
        for linea in log_snapshot[-_LOBBY_MAX_MENSAJES_LOG:]:  # Repite el bloque por cada elemento del iterable
            surf = f_pequena.render(f"› {linea}", True, _LOBBY_COLOR_TEXTO)
            ventana.blit(surf, (_LOBBY_MARGEN + 30, y_log))
            y_log += 22

        # Botón cancelar
        self._btn_cancelar.dibujar(ventana)

        pygame.display.flip()


