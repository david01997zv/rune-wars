def _dibujar_texto_centrado(  # Define una función o método
    superficie: pygame.Surface,
    texto: str,
    fuente,
    color: tuple,
    cx: int,
    cy: int,
):
    """
    Dibuja texto centrado horizontalmente en (cx, cy).

    Args:
        superficie (pygame.Surface): Destino.
        texto      (str)           : Texto a renderizar.
        fuente     (pygame.Font)   : Fuente de Pygame.
        color      (tuple)         : Color RGB.
        cx         (int)           : Centro X.
        cy         (int)           : Centro Y.
    """
    surf = fuente.render(texto, True, color)
    rect = surf.get_rect(center=(cx, cy))
    superficie.blit(surf, rect)


def _dibujar_texto_izq(  # Define una función o método
    superficie: pygame.Surface,
    texto: str,
    fuente,
    color: tuple,
    x: int,
    y: int,
):
    """
    Dibuja texto alineado a la izquierda en (x, y).

    Args:
        superficie (pygame.Surface): Destino.
        texto      (str)           : Texto.
        fuente     (pygame.Font)   : Fuente.
        color      (tuple)         : Color RGB.
        x          (int)           : Posición X izquierda.
        y          (int)           : Posición Y superior.
    """
    surf = fuente.render(texto, True, color)
    superficie.blit(surf, (x, y))


def _obtener_ip_local() -> str:  # Define una función o método
    """
    Obtiene la dirección IP local de la máquina en la red actual.

    Returns:
        str: IP local (ej. "192.168.1.5") o "127.0.0.1" si falla.
    """
    try:  # Intenta ejecutar el bloque; captura errores si ocurren
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        ip = s.getsockname()[0]
        s.close()
        return ip  # Devuelve un valor y termina la función
    except OSError:  # Captura y maneja el error producido en el bloque try
        return "127.0.0.1"  # Devuelve un valor y termina la función


