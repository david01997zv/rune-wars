# ---------------------------------------------------------------------------
# Constantes de tipo de mensaje
# ---------------------------------------------------------------------------

TIPO_UNIRSE    = "unirse"
TIPO_SALA_LISTA = "sala_lista"
TIPO_INICIO    = "inicio"
TIPO_MOVIMIENTO = "movimiento"
TIPO_ACTUALIZAR = "actualizar"
TIPO_VICTORIA  = "victoria"
TIPO_RENUNCIA  = "renuncia"
TIPO_PING      = "ping"
TIPO_PONG      = "pong"
TIPO_ERROR     = "error"
TIPO_CHAT      = "chat"

# Versión del protocolo para verificar compatibilidad
VERSION_PROTOCOLO = "1.0"

# Tamaño del encabezado de longitud (4 bytes, big-endian, unsigned int)
TAMANO_HEADER = 4

# Límites de seguridad
MAX_TAMANO_MENSAJE = 64 * 1024   # 64 KB máximo por mensaje
TIMEOUT_PING       = 10.0        # segundos sin pong → desconexión


# ---------------------------------------------------------------------------
# Serialización / deserialización con encabezado de longitud
# ---------------------------------------------------------------------------

def serializar_mensaje(datos: dict) -> bytes:  # Define una función o método
    """
    Convierte un diccionario a bytes con un encabezado de 4 bytes
    que indica la longitud del payload JSON.

    Formato del paquete:
        [4 bytes longitud (big-endian)] + [N bytes JSON UTF-8]

    Args:
        datos (dict): Mensaje a enviar. Debe contener la clave "tipo".

    Returns:
        bytes: Paquete listo para enviar por el socket.

    Raises:
        ValueError: Si el mensaje supera MAX_TAMANO_MENSAJE.
    """
    payload = json.dumps(datos, ensure_ascii=False).encode("utf-8")
    if len(payload) > MAX_TAMANO_MENSAJE:  # Evalúa una condición; ejecuta el bloque si es verdadera
        raise ValueError(  # Lanza una excepción de forma manual
            f"Mensaje demasiado grande: {len(payload)} bytes "
            f"(máximo {MAX_TAMANO_MENSAJE})"
        )
    header = struct.pack("!I", len(payload))
    return header + payload  # Devuelve un valor y termina la función


def deserializar_mensaje(datos_brutos: bytes) -> dict:  # Define una función o método
    """
    Decodifica bytes JSON a un diccionario de Python.

    Args:
        datos_brutos (bytes): Payload sin el encabezado de longitud.

    Returns:
        dict: Mensaje deserializado.

    Raises:
        json.JSONDecodeError: Si los bytes no son JSON válido.
    """
    return json.loads(datos_brutos.decode("utf-8"))  # Devuelve un valor y termina la función


def leer_mensaje_completo(sock) -> dict | None:  # Define una función o método
    """
    Lee un mensaje completo de un socket bloqueante.

    Primero lee los 4 bytes de encabezado para conocer la longitud,
    luego lee exactamente ese número de bytes del payload.

    Args:
        sock (socket.socket): Socket conectado en modo bloqueante.

    Returns:
        dict | None: Mensaje deserializado, o None si la conexión fue
                     cerrada limpiamente por el otro extremo.

    Raises:
        ConnectionError : Si se recibe una lectura parcial inesperada.
        ValueError      : Si el mensaje supera MAX_TAMANO_MENSAJE.
    """
    # Leer encabezado
    header_raw = _leer_exactamente(sock, TAMANO_HEADER)
    if header_raw is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
        return None  # Conexión cerrada

    longitud = struct.unpack("!I", header_raw)[0]

    if longitud > MAX_TAMANO_MENSAJE:  # Evalúa una condición; ejecuta el bloque si es verdadera
        raise ValueError(  # Lanza una excepción de forma manual
            f"Longitud declarada {longitud} excede el máximo permitido."
        )

    # Leer payload
    payload = _leer_exactamente(sock, longitud)
    if payload is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
        raise ConnectionError("Conexión cerrada durante la lectura del payload.")  # Lanza una excepción de forma manual

    return deserializar_mensaje(payload)  # Devuelve un valor y termina la función


def _leer_exactamente(sock, n: int) -> bytes | None:  # Define una función o método
    """
    Lee exactamente n bytes del socket, reintentando si es necesario.

    Args:
        sock (socket.socket): Socket a leer.
        n    (int): Número exacto de bytes a leer.

    Returns:
        bytes | None: Los bytes leídos, o None si la conexión cerró
                      limpiamente antes de recibir ningún byte.

    Raises:
        ConnectionError: Si la conexión se cierra a la mitad de la lectura.
    """
    datos = b""
    while len(datos) < n:  # Repite el bloque mientras la condición sea verdadera
        fragmento = sock.recv(n - len(datos))
        if not fragmento:  # Evalúa una condición; ejecuta el bloque si es verdadera
            if len(datos) == 0:  # Evalúa una condición; ejecuta el bloque si es verdadera
                return None   # Cierre limpio
            raise ConnectionError(  # Lanza una excepción de forma manual
                f"Conexión cerrada: se esperaban {n} bytes, "
                f"se recibieron {len(datos)}."
            )
        datos += fragmento
    return datos  # Devuelve un valor y termina la función


