def crear_pieza(tipo: str, jugador: str, fila: int, columna: int) -> Pieza:  # Define una función o método
    """
    Fábrica que instancia la subclase correcta según el tipo indicado.

    Args:
        tipo    (str): Tipo de pieza (constante de constantes.py).
        jugador (str): Propietario de la pieza.
        fila    (int): Fila inicial.
        columna (int): Columna inicial.

    Returns:
        Pieza: Instancia concreta de la subclase correspondiente.

    Raises:
        ValueError: Si el tipo no es reconocido.
    """
    mapa = {
        GUARDIAN:  Guardian,
        INVOKER:   Invoker,
        LANCER:    Lancer,
        SENTINEL:  Sentinel,
        HEXBLADE:  Hexblade,
        RUNE_PAWN: RunePawn,
    }
    if tipo not in mapa:  # Evalúa una condición; ejecuta el bloque si es verdadera
        raise ValueError(f"Tipo de pieza desconocido: '{tipo}'")  # Lanza una excepción de forma manual
    return mapa[tipo](jugador, fila, columna)  # Devuelve un valor y termina la función


