# Símbolos Unicode para cada tipo de pieza
_SIMBOLOS = {
    GUARDIAN:  "★",  # Símbolo distintivo para no confundirlo con el Invoker (♛)
    INVOKER:   "♛",
    LANCER:    "♝",
    SENTINEL:  "♜",
    HEXBLADE:  "♞",
    RUNE_PAWN: "♟",
}

# Ancho del panel lateral
_PANEL_X = OFFSET_X + COLUMNAS * TAMANO_CELDA + 20
_PANEL_W = ANCHO_VENTANA - _PANEL_X - 10


class Renderizador:  # Define una clase (plantilla para crear objetos)
    """
    Maneja todo el renderizado visual del juego Rune Wars.

    Attributes:
        ventana (pygame.Surface): Superficie principal de la ventana.
        fuentes (dict)          : Fuentes precargadas por tamaño/rol.
        _tick   (int)           : Contador de frames para animaciones.
    """

    def __init__(self, ventana: pygame.Surface) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa el renderizador y precarga las fuentes.

        Args:
            ventana (pygame.Surface): Ventana principal de Pygame.
        """
        self.ventana = ventana
        self._tick   = 0
        self.fuentes = self._cargar_fuentes()

        # Superficie para efectos de transparencia
        self._surf_alpha = pygame.Surface(
            (TAMANO_CELDA, TAMANO_CELDA), pygame.SRCALPHA
        )

    # ------------------------------------------------------------------
    # Carga de fuentes
    # ------------------------------------------------------------------

    def _cargar_fuentes(self) -> dict:  # Define una función o método
        """
        Precarga las fuentes del juego con pygame.font.

        Returns:
            dict: Diccionario de fuentes por clave.
        """
        pygame.font.init()
        try:  # Intenta ejecutar el bloque; captura errores si ocurren
            fuentePieza  = pygame.font.SysFont("segoeuisymbol", 46, bold=True)
        except Exception:  # Captura y maneja el error producido en el bloque try
            fuentePieza  = pygame.font.SysFont("dejavusans", 46, bold=True)

        return {  # Devuelve un valor y termina la función
            "pieza":      fuentePieza,
            "titulo":     pygame.font.SysFont("arial", 48, bold=True),
            "grande":     pygame.font.SysFont("arial", 32, bold=True),
            "mediana":    pygame.font.SysFont("arial", 22),
            "normal":     pygame.font.SysFont("arial", 20),
            "pequena":    pygame.font.SysFont("arial", 16),
            "pequeña":    pygame.font.SysFont("arial", 16),   # alias con tilde
            "coordenada": pygame.font.SysFont("arial", 13),
        }

    # ------------------------------------------------------------------
    # Frame principal
    # ------------------------------------------------------------------

    def dibujar_todo(self, tablero) -> None:  # Define una función o método
        """
        Dibuja el frame completo del juego.

        Args:
            tablero (Tablero): Estado actual del tablero lógico.
        """
        self._tick += 1
        self.ventana.fill(COLOR_FONDO)
        self._dibujar_tablero(tablero)
        self._dibujar_coordenadas()
        self._dibujar_piezas(tablero.cuadricula)
        self._dibujar_panel(tablero.estado)

    # ------------------------------------------------------------------
    # Tablero y casillas
    # ------------------------------------------------------------------

    def _dibujar_tablero(self, tablero) -> None:  # Define una función o método
        """
        Dibuja el fondo del tablero con highlights de selección y movimientos.

        Args:
            tablero (Tablero): Estado actual (cuadrícula + highlights).
        """
        # Borde exterior del tablero
        bordeRect = pygame.Rect(
            OFFSET_X - 4, OFFSET_Y - 4,
            COLUMNAS * TAMANO_CELDA + 8, FILAS * TAMANO_CELDA + 8,
        )
        pygame.draw.rect(self.ventana, COLOR_BORDE_TABLERO, bordeRect, 3, border_radius=4)

        for fila in range(FILAS):  # Repite el bloque por cada elemento del iterable
            for col in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
                x = OFFSET_X + col * TAMANO_CELDA
                y = OFFSET_Y + fila * TAMANO_CELDA
                rect = pygame.Rect(x, y, TAMANO_CELDA, TAMANO_CELDA)

                # Color base
                colorBase = COLOR_CELDA_CLARA if (fila + col) % 2 == 0 else COLOR_CELDA_OSCURA
                pygame.draw.rect(self.ventana, colorBase, rect)

                # Highlight de selección / movimiento / ataque
                tipoHighlight = tablero.highlights.get((fila, col))
                if tipoHighlight == "movimiento":  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._surf_alpha.fill((0, 0, 0, 0))
                    pygame.draw.circle(
                        self._surf_alpha, (*COLOR_MOVIMIENTO[:3], 160),
                        (TAMANO_CELDA // 2, TAMANO_CELDA // 2), 14
                    )
                    self.ventana.blit(self._surf_alpha, (x, y))
                elif tipoHighlight == "ataque":  # Condición alternativa si la anterior fue falsa
                    self._surf_alpha.fill((0, 0, 0, 0))
                    pygame.draw.rect(
                        self._surf_alpha, (*COLOR_ATAQUE[:3], 140),
                        (2, 2, TAMANO_CELDA - 4, TAMANO_CELDA - 4), border_radius=6
                    )
                    self.ventana.blit(self._surf_alpha, (x, y))

                # Highlight de casilla seleccionada
                if tablero.highlights.get("sel") == (fila, col):  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._surf_alpha.fill((0, 0, 0, 0))
                    pygame.draw.rect(
                        self._surf_alpha, (*COLOR_SELECCION[:3], 180),
                        (0, 0, TAMANO_CELDA, TAMANO_CELDA), border_radius=4
                    )
                    self.ventana.blit(self._surf_alpha, (x, y))

    def _dibujar_coordenadas(self) -> None:  # Define una función o método
        """Dibuja las letras de columna (a-h) y números de fila (1-8) alrededor del tablero."""
        letras = "abcdefgh"
        fuente = self.fuentes["coordenada"]
        for col in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
            x = OFFSET_X + col * TAMANO_CELDA + TAMANO_CELDA // 2
            # Abajo
            surf = fuente.render(letras[col], True, COLOR_TEXTO_DIM)
            self.ventana.blit(surf, (x - surf.get_width() // 2, OFFSET_Y + FILAS * TAMANO_CELDA + 4))
        for fila in range(FILAS):  # Repite el bloque por cada elemento del iterable
            y = OFFSET_Y + fila * TAMANO_CELDA + TAMANO_CELDA // 2
            # Izquierda
            surf = fuente.render(str(8 - fila), True, COLOR_TEXTO_DIM)
            self.ventana.blit(surf, (OFFSET_X - 18, y - surf.get_height() // 2))

    # ------------------------------------------------------------------
    # Piezas
    # ------------------------------------------------------------------

    def _dibujar_piezas(self, cuadricula: list) -> None:  # Define una función o método
        """
        Dibuja todas las piezas sobre el tablero con efecto de glow animado.

        Args:
            cuadricula (list): Cuadrícula 8x8 con objetos Pieza o None.
        """
        glowFactor = (math.sin(self._tick * 0.05) + 1) / 2  # 0.0 – 1.0

        for fila in range(FILAS):  # Repite el bloque por cada elemento del iterable
            for col in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
                pieza = cuadricula[fila][col]
                if pieza is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    continue  # Salta a la siguiente iteración del bucle

                x = OFFSET_X + col * TAMANO_CELDA
                y = OFFSET_Y + fila * TAMANO_CELDA
                cx = x + TAMANO_CELDA // 2
                cy = y + TAMANO_CELDA // 2

                color = COLOR_J1 if pieza.jugador == JUGADOR_1 else COLOR_J2

                # Glow suave (círculo semitransparente)
                glowAlpha = int(40 + glowFactor * 30)
                self._surf_alpha.fill((0, 0, 0, 0))
                pygame.draw.circle(
                    self._surf_alpha,
                    (*COLOR_RUNA_GLOW, glowAlpha),
                    (TAMANO_CELDA // 2, TAMANO_CELDA // 2),
                    28,
                )
                self.ventana.blit(self._surf_alpha, (x, y))

                # Símbolo de la pieza
                simbolo = _SIMBOLOS.get(pieza.tipo, "?")
                surf = self.fuentes["pieza"].render(simbolo, True, color)
                self.ventana.blit(
                    surf,
                    (cx - surf.get_width() // 2, cy - surf.get_height() // 2),
                )

    # ------------------------------------------------------------------
    # Panel lateral
    # ------------------------------------------------------------------

    def _dibujar_panel(self, estado: dict) -> None:  # Define una función o método
        """
        Dibuja el panel lateral con información del estado de la partida.

        Args:
            estado (dict): Estado actual del tablero (turno, energías, capturas).
        """
        # Fondo del panel
        panelRect = pygame.Rect(_PANEL_X, OFFSET_Y, _PANEL_W, FILAS * TAMANO_CELDA)
        pygame.draw.rect(self.ventana, COLOR_PANEL, panelRect, border_radius=8)
        pygame.draw.rect(self.ventana, COLOR_BORDE_TABLERO, panelRect, 2, border_radius=8)

        y = OFFSET_Y + 16
        cx = _PANEL_X + _PANEL_W // 2

        # Título
        self._texto_centrado("⚔ RUNE WARS ⚔", self.fuentes["grande"], COLOR_TITULO, cx, y)
        y += 42

        # Turno
        jugActivo = estado["jugador_activo"]
        colorActivo = COLOR_J1 if jugActivo == JUGADOR_1 else COLOR_J2
        labelTurno = "Turno J1" if jugActivo == JUGADOR_1 else "Turno J2"
        self._texto_centrado(f"● {labelTurno}", self.fuentes["mediana"], colorActivo, cx, y)
        y += 30

        numTurno = estado.get("turno_numero", 1)
        self._texto_centrado(f"Turno #{numTurno}", self.fuentes["pequena"], COLOR_TEXTO_DIM, cx, y)
        y += 36

        # Separador
        pygame.draw.line(
            self.ventana, COLOR_BORDE_TABLERO,
            (_PANEL_X + 10, y), (_PANEL_X + _PANEL_W - 10, y), 1
        )
        y += 14

        # Energía J1
        energiaJ1 = estado.get("energia_j1", 0)
        self._dibujar_energia("J1 — Energía", energiaJ1, COLOR_J1, y)
        y += 50

        # Energía J2
        energiaJ2 = estado.get("energia_j2", 0)
        self._dibujar_energia("J2 — Energía", energiaJ2, COLOR_J2, y)
        y += 58

        # Separador
        pygame.draw.line(
            self.ventana, COLOR_BORDE_TABLERO,
            (_PANEL_X + 10, y), (_PANEL_X + _PANEL_W - 10, y), 1
        )
        y += 14

        # Capturas
        capJ1 = estado.get("capturas_j1", 0)
        capJ2 = estado.get("capturas_j2", 0)
        self._texto_centrado("Capturas", self.fuentes["pequena"], COLOR_TEXTO_DIM, cx, y)
        y += 22
        self._texto_centrado(f"J1: {capJ1}   J2: {capJ2}", self.fuentes["mediana"], COLOR_TEXTO, cx, y)

    def _dibujar_energia(self, etiqueta: str, valor: int, color: tuple, y: int) -> None:  # Define una función o método
        """
        Dibuja la barra de energía de runas de un jugador.

        Cuando la energía está al máximo, muestra el texto '¡RUNA ACTIVA!'
        para indicar que la habilidad especial está disponible.

        Args:
            etiqueta (str)  : Texto descriptivo.
            valor    (int)  : Energía actual (0-5).
            color    (tuple): Color del jugador.
            y        (int)  : Posición vertical de inicio.
        """
        cx = _PANEL_X + _PANEL_W // 2
        self._texto_centrado(etiqueta, self.fuentes["pequena"], COLOR_TEXTO_DIM, cx, y)
        y += 18

        # Puntos de energía
        totalAncho = ENERGIA_MAX * 22
        startX = _PANEL_X + (_PANEL_W - totalAncho) // 2
        for i in range(ENERGIA_MAX):  # Repite el bloque por cada elemento del iterable
            colorPunto = color if i < valor else (50, 40, 80)
            pygame.draw.circle(
                self.ventana, colorPunto,
                (startX + i * 22 + 8, y + 8), 8
            )
            if i < valor:  # Evalúa una condición; ejecuta el bloque si es verdadera
                pygame.draw.circle(
                    self.ventana, (255, 255, 255),
                    (startX + i * 22 + 8, y + 8), 8, 1
                )

        # Indicador de habilidad activa cuando la energía está llena
        if valor >= ENERGIA_MAX:
            y += 18
            self._texto_centrado("⚡ ¡RUNA ACTIVA!", self.fuentes["pequena"], (255, 220, 80), cx, y)

    def _texto_centrado(  # Define una función o método
        self, texto: str, fuente: pygame.font.Font,
        color: tuple, cx: int, y: int
    ) -> None:
        """
        Renderiza texto centrado horizontalmente.

        Args:
            texto  (str)           : Texto a mostrar.
            fuente (pygame.font.Font): Fuente a usar.
            color  (tuple)         : Color RGB.
            cx     (int)           : Centro horizontal.
            y      (int)           : Posición vertical superior.
        """
        surf = fuente.render(texto, True, color)
        self.ventana.blit(surf, (cx - surf.get_width() // 2, y))

    # ------------------------------------------------------------------
    # Pantallas especiales
    # ------------------------------------------------------------------

    def mostrar_pantalla_victoria(self, ganador: str, razon: str) -> None:  # Define una función o método
        """
        Dibuja la pantalla de victoria sobre el juego.

        Args:
            ganador (str): JUGADOR_1 o JUGADOR_2.
            razon   (str): Texto descriptivo de la victoria.
        """
        overlay = pygame.Surface((ANCHO_VENTANA, ALTO_VENTANA), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 180))
        self.ventana.blit(overlay, (0, 0))

        cx = ANCHO_VENTANA // 2
        cy = ALTO_VENTANA // 2

        labelGanador = "Jugador 1" if ganador == JUGADOR_1 else "Jugador 2"
        colorGanador = COLOR_J1 if ganador == JUGADOR_1 else COLOR_J2

        # Caja central
        cajaRect = pygame.Rect(cx - 220, cy - 120, 440, 240)
        pygame.draw.rect(self.ventana, (20, 15, 45), cajaRect, border_radius=16)
        pygame.draw.rect(self.ventana, COLOR_BORDE_TABLERO, cajaRect, 3, border_radius=16)

        self._texto_centrado("¡Victoria!", self.fuentes["titulo"], COLOR_TITULO, cx, cy - 100)
        self._texto_centrado(labelGanador, self.fuentes["grande"], colorGanador, cx, cy - 40)
        self._texto_centrado(razon, self.fuentes["pequena"], COLOR_TEXTO_DIM, cx, cy + 10)
        self._texto_centrado(
            "Presiona R para reiniciar · ESC para salir",
            self.fuentes["pequena"], COLOR_TEXTO_DIM, cx, cy + 60
        )

    def mostrar_notificacion(self, texto: str) -> None:  # Define una función o método
        """
        Muestra un aviso temporal en la parte superior de la pantalla.

        Args:
            texto (str): Mensaje a mostrar.
        """
        surf = self.fuentes["mediana"].render(texto, True, COLOR_TITULO)
        x = ANCHO_VENTANA // 2 - surf.get_width() // 2
        self.ventana.blit(surf, (x, 8))

    def actualizar_panel(self, estado: dict) -> None:  # Define una función o método
        """
        Actualiza el panel lateral (alias para ser llamado desde red).

        Args:
            estado (dict): Estado actual del tablero.
        """
        self._dibujar_panel(estado)


