def _cargar_fuentes() -> dict:  # Define una función o método
    """
    Precarga todas las fuentes utilizadas en el juego.

    Returns:
        dict: Diccionario de fuentes por clave de rol.
    """
    pygame.font.init()
    try:  # Intenta ejecutar el bloque; captura errores si ocurren
        fuentePieza = pygame.font.SysFont("segoeuisymbol", 46, bold=True)
    except Exception:  # Captura y maneja el error producido en el bloque try
        fuentePieza = pygame.font.SysFont("dejavusans", 46, bold=True)

    fuenteBase = {
        "pieza":      fuentePieza,
        "titulo":     pygame.font.SysFont("arial", 48, bold=True),
        "grande":     pygame.font.SysFont("arial", 32, bold=True),
        "mediana":    pygame.font.SysFont("arial", 22),
        "normal":     pygame.font.SysFont("arial", 20),
        "pequena":    pygame.font.SysFont("arial", 16),
        "pequeña":    pygame.font.SysFont("arial", 16),   # alias con tilde para lobby
        "coordenada": pygame.font.SysFont("arial", 13),
    }
    return fuenteBase  # Devuelve un valor y termina la función


def main() -> None:  # Define una función o método
    """
    Función principal que arranca Rune Wars.

    Gestiona el ciclo menú → juego → menú hasta que el usuario
    elige salir o cierra la ventana.
    """
    pygame.init()
    ventana = pygame.display.set_mode((ANCHO_VENTANA, ALTO_VENTANA))
    pygame.display.set_caption(TITULO_JUEGO)

    try:  # Intenta ejecutar el bloque; captura errores si ocurren
        iconoSurf = pygame.Surface((32, 32))
        iconoSurf.fill((15, 12, 30))
        pygame.display.set_icon(iconoSurf)
    except Exception:  # Captura y maneja el error producido en el bloque try
        pass  # No hace nada; marcador de bloque vacío

    fuentes = _cargar_fuentes()
    menu    = Menu(ventana, fuentes)
    juego   = Juego(ventana)

    ejecutando = True
    while ejecutando:  # Repite el bloque mientras la condición sea verdadera
        accion = menu.ejecutar()

        if accion == "local":  # Evalúa una condición; ejecuta el bloque si es verdadera
            juego = Juego(ventana)
            resultado = juego.ejecutar_local()
            if resultado == "salir":  # Evalúa una condición; ejecuta el bloque si es verdadera
                ejecutando = False

        elif accion == "vs_pc":  # Condición alternativa si la anterior fue falsa
            juego = Juego(ventana)
            juego.activar_modo_pc(profundidad=2)
            resultado = juego.ejecutar_local()
            if resultado == "salir":  # Evalúa una condición; ejecuta el bloque si es verdadera
                ejecutando = False

        elif accion == "servidor":  # Condición alternativa si la anterior fue falsa
            # Lanzar lobby de anfitrión con el tablero del juego
            juego = Juego(ventana)   # tablero fresco
            lobby = LobbyAnfitrion(
                ventana=ventana,
                fuentes=fuentes,
                nombre_jugador="Anfitrión",
                puerto=5555,
                tablero_logica=juego.tablero,
            )
            resultado_lobby = lobby.ejecutar()
            if resultado_lobby == ACCION_INICIAR_PARTIDA:  # Evalúa una condición; ejecuta el bloque si es verdadera
                juego.configurar_red(lobby._servidor, esServidor=True)
                res = juego.ejecutar_local()
                if res == "salir":  # Evalúa una condición; ejecuta el bloque si es verdadera
                    ejecutando = False

        elif accion == "cliente":  # Condición alternativa si la anterior fue falsa
            lobby = LobbyInvitado(
                ventana=ventana,
                fuentes=fuentes,
                nombre_default="Jugador",
            )
            resultado_lobby = lobby.ejecutar()
            if resultado_lobby == ACCION_INICIAR_PARTIDA and lobby._cliente:  # Evalúa una condición; ejecuta el bloque si es verdadera
                juego = Juego(ventana)
                # 1) Registrar callbacks del Juego ANTES de arrancar el hilo
                juego.configurar_red(lobby._cliente, esServidor=False)
                # 2) Arrancar escucha; el TIPO_INICIO sincronizará el tablero
                lobby._cliente.iniciar_escucha()
                # 3) Bucle de juego; el estado llega por la cola de eventos
                res = juego.ejecutar_local()
                if res == "salir":  # Evalúa una condición; ejecuta el bloque si es verdadera
                    ejecutando = False

        elif accion == "salir":  # Condición alternativa si la anterior fue falsa
            ejecutando = False

    pygame.quit()
    sys.exit()


if __name__ == "__main__":  # Evalúa una condición; ejecuta el bloque si es verdadera
    main()



