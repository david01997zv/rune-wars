class PCRuneWars:  # Define una clase (plantilla para crear objetos)
    """
    Inteligencia Artificial para Rune Wars usando minimax con poda alfa-beta.

    Evalúa posiciones del tablero y selecciona el mejor movimiento para
    el jugador JUGADOR_2 (la PC siempre juega como jugador_2).

    Attributes:
        profundidad (int): Profundidad máxima de búsqueda del árbol de juego.
        jugador_pc  (str): Identificador del jugador PC.
        jugador_hum (str): Identificador del jugador humano.
    """

    # Valores de material de cada pieza
    _VALOR_PIEZA = {
        GUARDIAN:  10000,
        INVOKER:   900,
        LANCER:    300,
        SENTINEL:  500,
        HEXBLADE:  350,
        RUNE_PAWN: 100,
    }

    def __init__(self, profundidad: int = 2) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa la PC.

        Args:
            profundidad (int): Profundidad del árbol minimax (2 = moderada).
        """
        self.profundidad = profundidad
        self.jugador_pc  = JUGADOR_2
        self.jugador_hum = JUGADOR_1

    def elegir_movimiento(self, tablero: "Tablero") -> tuple | None:  # Define una función o método
        """
        Elige el mejor movimiento para la PC en el estado actual.

        Args:
            tablero (Tablero): Estado actual del juego.

        Returns:
            tuple | None: ((fila_origen, col_origen), (fila_destino, col_destino))
                          o None si no hay movimientos posibles.
        """
        movimientos = self._obtener_todos_movimientos(tablero, self.jugador_pc)
        if not movimientos:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return None  # Devuelve un valor y termina la función

        mejorValor = -math.inf
        mejorMov   = None

        for origen, destino in movimientos:  # Repite el bloque por cada elemento del iterable
            tableroSim = self._simular(tablero, origen, destino)
            valor = self._minimax(
                tableroSim,
                self.profundidad - 1,
                -math.inf, math.inf,
                esMaximizador=False,
            )
            if valor > mejorValor:  # Evalúa una condición; ejecuta el bloque si es verdadera
                mejorValor = valor
                mejorMov   = (origen, destino)

        return mejorMov  # Devuelve un valor y termina la función

    # ------------------------------------------------------------------
    # Minimax con alfa-beta
    # ------------------------------------------------------------------

    def _minimax(  # Define una función o método
        self,
        tablero: "Tablero",
        profundidad: int,
        alfa: float,
        beta: float,
        esMaximizador: bool,
    ) -> float:
        """
        Implementa minimax con poda alfa-beta.

        Args:
            tablero       (Tablero): Estado del nodo actual.
            profundidad   (int)    : Profundidad restante de búsqueda.
            alfa          (float)  : Mejor valor garantizado para el maximizador.
            beta          (float)  : Mejor valor garantizado para el minimizador.
            esMaximizador (bool)   : True si es turno de la PC.

        Returns:
            float: Evaluación heurística del nodo.
        """
        if profundidad == 0 or tablero.ganador is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return self._evaluar(tablero)  # Devuelve un valor y termina la función

        jugadorActual = self.jugador_pc if esMaximizador else self.jugador_hum
        movimientos   = self._obtener_todos_movimientos(tablero, jugadorActual)

        if not movimientos:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return self._evaluar(tablero)  # Devuelve un valor y termina la función

        if esMaximizador:  # Evalúa una condición; ejecuta el bloque si es verdadera
            valorMax = -math.inf
            for origen, destino in movimientos:  # Repite el bloque por cada elemento del iterable
                sim   = self._simular(tablero, origen, destino)
                valor = self._minimax(sim, profundidad - 1, alfa, beta, False)
                valorMax = max(valorMax, valor)
                alfa     = max(alfa, valorMax)
                if beta <= alfa:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    break  # poda
            return valorMax  # Devuelve un valor y termina la función
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            valorMin = math.inf
            for origen, destino in movimientos:  # Repite el bloque por cada elemento del iterable
                sim   = self._simular(tablero, origen, destino)
                valor = self._minimax(sim, profundidad - 1, alfa, beta, True)
                valorMin = min(valorMin, valor)
                beta     = min(beta, valorMin)
                if beta <= alfa:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    break  # poda
            return valorMin  # Devuelve un valor y termina la función

    # ------------------------------------------------------------------
    # Evaluación heurística
    # ------------------------------------------------------------------

    def _evaluar(self, tablero: "Tablero") -> float:  # Define una función o método
        """
        Asigna un valor numérico al estado del tablero desde la perspectiva de la PC.

        Positivo = ventaja para la PC (jugador_2).
        Negativo = ventaja para el humano (jugador_1).

        Args:
            tablero (Tablero): Estado a evaluar.

        Returns:
            float: Puntuación heurística.
        """
        if tablero.ganador == self.jugador_pc:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return 100000.0  # Devuelve un valor y termina la función
        if tablero.ganador == self.jugador_hum:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return -100000.0  # Devuelve un valor y termina la función

        puntuacion = 0.0
        for fila in tablero.cuadricula:  # Repite el bloque por cada elemento del iterable
            for pieza in fila:  # Repite el bloque por cada elemento del iterable
                if pieza is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    continue  # Salta a la siguiente iteración del bucle
                valor = self._VALOR_PIEZA.get(pieza.tipo, 0)
                # Bonus de movilidad (numero de movimientos disponibles)
                movilidad = len(pieza.movimientos_validos(tablero.cuadricula)) * 2
                if pieza.jugador == self.jugador_pc:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    puntuacion += valor + movilidad
                else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                    puntuacion -= valor + movilidad

        return puntuacion  # Devuelve un valor y termina la función

    # ------------------------------------------------------------------
    # Utilidades
    # ------------------------------------------------------------------

    def _obtener_todos_movimientos(  # Define una función o método
        self,
        tablero: "Tablero",
        jugador: str,
    ) -> list[tuple]:
        """
        Recopila todos los movimientos legales para un jugador en el tablero.

        Respeta la habilidad de runa (energía máxima) de la misma forma que
        lo hace Tablero.seleccionar_pieza, para que los movimientos generados
        aquí sean siempre consistentes con los highlights que se usarán al
        ejecutar el movimiento real.

        Args:
            tablero (Tablero): Estado actual.
            jugador (str)    : Jugador cuyos movimientos se calculan.

        Returns:
            list[tuple]: Lista de ((fila_o, col_o), (fila_d, col_d)).
        """
        movimientos = []
        claveEnergia = "energia_j1" if jugador == JUGADOR_1 else "energia_j2"
        runaActiva   = tablero.estado.get(claveEnergia, 0) >= ENERGIA_MAX

        for fi in range(FILAS):  # Repite el bloque por cada elemento del iterable
            for ci in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
                pieza = tablero.cuadricula[fi][ci]
                if pieza is None or pieza.jugador != jugador:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    continue  # Salta a la siguiente iteración del bucle

                if runaActiva and pieza.tipo in (INVOKER, LANCER, SENTINEL):
                    # Habilidad de runa: las piezas de línea atraviesan aliados
                    cuadriculaTmp = [fila[:] for fila in tablero.cuadricula]
                    for fj in range(FILAS):
                        for cj in range(COLUMNAS):
                            p = cuadriculaTmp[fj][cj]
                            if p is not None and p.jugador == jugador and (fj, cj) != (fi, ci):
                                cuadriculaTmp[fj][cj] = None
                    destinos = pieza.movimientos_validos(cuadriculaTmp)
                else:
                    destinos = pieza.movimientos_validos(tablero.cuadricula)

                for destino in destinos:  # Repite el bloque por cada elemento del iterable
                    movimientos.append(((fi, ci), destino))
        return movimientos  # Devuelve un valor y termina la función

    def _simular(  # Define una función o método
        self,
        tablero: "Tablero",
        origen: tuple,
        destino: tuple,
    ) -> "Tablero":
        """
        Crea una copia del tablero con el movimiento aplicado.

        No modifica el tablero original. Usa serialización para clonar.

        Args:
            tablero  (Tablero): Estado actual.
            origen   (tuple)  : (fila, col) de la pieza a mover.
            destino  (tuple)  : (fila, col) de destino.

        Returns:
            Tablero: Nuevo tablero con el movimiento ejecutado.
        """
        nuevoTablero = Tablero.__new__(Tablero)
        # Copiar cuadricula
        nuevoTablero.cuadricula = [
            [None] * COLUMNAS for _ in range(FILAS)
        ]
        for fi in range(FILAS):  # Repite el bloque por cada elemento del iterable
            for ci in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
                p = tablero.cuadricula[fi][ci]
                if p is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    nueva = crear_pieza(p.tipo, p.jugador, fi, ci)
                    nueva.movida  = p.movida
                    nueva.energia = p.energia
                    nuevoTablero.cuadricula[fi][ci] = nueva
        nuevoTablero.estado    = dict(tablero.estado)
        nuevoTablero.pieza_sel = None
        nuevoTablero.highlights = {}
        nuevoTablero.ganador   = tablero.ganador
        nuevoTablero.razon     = tablero.razon

        # Aplicar movimiento
        fo, co = origen
        fd, cd = destino
        pieza = nuevoTablero.cuadricula[fo][co]
        if pieza is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return nuevoTablero  # Devuelve un valor y termina la función

        nuevoTablero.seleccionar_pieza(fo, co)
        nuevoTablero.mover_pieza(fd, cd)

        return nuevoTablero  # Devuelve un valor y termina la función


