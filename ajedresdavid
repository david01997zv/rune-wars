logging.basicConfig(
    level=logging.INFO,
    format="[SERVIDOR %(asctime)s] %(levelname)s: %(message)s",
    datefmt="%H:%M:%S",
)
log = logging.getLogger("servidor")


# ---------------------------------------------------------------------------
# Constantes internas del servidor
# ---------------------------------------------------------------------------

JUGADOR_1_ID = "jugador_1"
JUGADOR_2_ID = "jugador_2"
MAX_JUGADORES = 1  # Solo el invitado (jugador_2) conecta por TCP; el anfitrion es jugador_1 local
INTERVALO_PING = 5.0          # segundos entre pings
BACKLOG_CONEXIONES = 2        # cola de conexiones pendientes


class Servidor:  # Define una clase (plantilla para crear objetos)
    """
    Servidor de partida para Rune Wars (modo 1v1 en red).

    Gestiona todo el ciclo de vida de una partida:
    espera de jugadores → inicio → bucle de movimientos → fin.

    Attributes:
        host             (str)  : Dirección IP de escucha ('' = todas las interfaces).
        puerto           (int)  : Puerto TCP de escucha.
        tablero_logica          : Instancia del controlador de tablero del juego local.
        en_callback_estado      : Callable opcional para notificar cambios a la UI.
        _sock_servidor          : Socket principal de escucha.
        _clientes        (dict) : {jugador_id: {"sock": …, "nombre": …, "vivo": bool}}.
        _partida_activa  (bool) : True mientras hay partida en curso.
        _lock            (Lock) : Mutex para acceder al estado del tablero.
    """

    def __init__(  # Constructor: inicializa el objeto al crearlo
        self,
        puerto: int = 5555,
        host: str = "",
        tablero_logica=None,
        en_callback_estado: Callable | None = None,
    ):
        """
        Inicializa el servidor sin abrir el socket todavía.

        Args:
            puerto            (int)     : Puerto TCP de escucha.
            host              (str)     : IP de escucha ('0.0.0.0' para todas).
            tablero_logica              : Objeto Tablero con el estado del juego.
            en_callback_estado (Callable): Función callback(evento: dict) que
                                           recibe notificaciones de cambio de estado
                                           para actualizar la UI del servidor.
        """
        self.host = host
        self.puerto = puerto
        self.tablero_logica = tablero_logica
        self.en_callback_estado = en_callback_estado

        self._sock_servidor: socket.socket | None = None
        self._clientes: dict = {}
        self._partida_activa = False
        self._lock = threading.Lock()
        self._hilos: list[threading.Thread] = []
        self._nombre_anfitrion: str = "Anfitrión"

    # -----------------------------------------------------------------------
    # Ciclo principal
    # -----------------------------------------------------------------------

    def iniciar(self):  # Define una función o método
        """
        Abre el socket, espera exactamente 2 jugadores y arranca la partida.

        Este método es bloqueante. Para usarlo con una UI de Pygame, lanzarlo
        en un hilo separado:
            hilo = threading.Thread(target=servidor.iniciar, daemon=True)
            hilo.start()

        Raises:
            OSError: Si el puerto ya está en uso.
        """
        self._sock_servidor = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self._sock_servidor.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self._sock_servidor.bind((self.host, self.puerto))
        self._sock_servidor.listen(BACKLOG_CONEXIONES)
        log.info(f"Esperando jugadores en puerto {self.puerto}…")

        try:  # Intenta ejecutar el bloque; captura errores si ocurren
            while len(self._clientes) < MAX_JUGADORES:  # Repite el bloque mientras la condición sea verdadera
                conn, addr = self._sock_servidor.accept()
                # El único cliente TCP es siempre el invitado (jugador_2)
                jugador_id = JUGADOR_2_ID
                log.info(f"Conexión entrante {addr} → asignado como {jugador_id}")
                self._clientes[jugador_id] = {
                    "sock":   conn,
                    "nombre": "Jugador 2",
                    "vivo":   True,
                    "ultimo_pong": time.time(),
                }
        except Exception as exc:  # Captura y maneja el error producido en el bloque try
            log.error(f"Error al aceptar conexiones: {exc}")
            self.detener()
            return  # Devuelve un valor y termina la función

        # Intercambio de nombres (mensaje TIPO_UNIRSE)
        self._recibir_nombres()

        # Notificar a cada cliente su asignación y el nombre del rival
        self._enviar_sala_lista()

        # Iniciar la partida
        self._iniciar_partida()

    def detener(self):  # Define una función o método
        """
        Cierra todos los sockets de forma ordenada y señala el fin de la partida.
        """
        self._partida_activa = False
        for info in self._clientes.values():  # Repite el bloque por cada elemento del iterable
            _cerrar_socket_seguro(info["sock"])
        if self._sock_servidor:  # Evalúa una condición; ejecuta el bloque si es verdadera
            _cerrar_socket_seguro(self._sock_servidor)
        log.info("Servidor detenido.")

    # -----------------------------------------------------------------------
    # Métodos privados de inicialización
    # -----------------------------------------------------------------------

    def _recibir_nombres(self):  # Define una función o método
        """
        Lee el mensaje TIPO_UNIRSE del cliente TCP (jugador_2) para obtener su nombre.

        Si el cliente no envía un mensaje válido, se asigna nombre por defecto.
        """
        info_j2 = self._clientes.get(JUGADOR_2_ID)
        if info_j2:  # Evalúa una condición; ejecuta el bloque si es verdadera
            try:  # Intenta ejecutar el bloque; captura errores si ocurren
                mensaje = leer_mensaje_completo(info_j2["sock"])
                if mensaje and mensaje.get("tipo") == TIPO_UNIRSE:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    info_j2["nombre"] = mensaje.get("nombre", "Jugador 2")[:20]
                    log.info(f"jugador_2 se presentó como '{info_j2['nombre']}'")
            except Exception as exc:  # Captura y maneja el error producido en el bloque try
                log.warning(f"No se pudo leer nombre de jugador_2: {exc}")

    def _enviar_sala_lista(self):  # Define una función o método
        """
        Notifica al cliente TCP (jugador_2) su rol y el nombre del anfitrion.
        El anfitrion (jugador_1) se comunica directamente en memoria.
        """
        info_j2 = self._clientes.get(JUGADOR_2_ID)
        if info_j2:  # Evalúa una condición; ejecuta el bloque si es verdadera
            nombre_j2 = info_j2.get("nombre", "Jugador 2")
            rival_nombre = self._nombre_anfitrion
            mensaje = msg_sala_lista(JUGADOR_2_ID, rival_nombre)
            self._enviar_a(info_j2["sock"], mensaje)
            log.info(f"SALA_LISTA enviado a jugador_2. Rival: {rival_nombre}")

    def _iniciar_partida(self):  # Define una función o método
        """
        Envía el estado inicial del tablero a ambos clientes y lanza los hilos
        de escucha y ping por cada conexión.
        """
        self._partida_activa = True

        # Serializar estado inicial si hay tablero_logica conectado
        estado_inicial = {}
        if self.tablero_logica is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            estado_inicial = serializar_estado(self.tablero_logica)

        inicio_msg = msg_inicio(estado_inicial)
        self._difundir(inicio_msg)
        log.info("Partida iniciada. Enviando INICIO a ambos jugadores.")

        # Hilo de escucha por cada cliente
        for jugador_id, info in self._clientes.items():  # Repite el bloque por cada elemento del iterable
            hilo = threading.Thread(
                target=self._escuchar_cliente,
                args=(jugador_id, info["sock"]),
                daemon=True,
            )
            hilo.start()
            self._hilos.append(hilo)

        # Hilo de ping global
        hilo_ping = threading.Thread(target=self._bucle_ping, daemon=True)
        hilo_ping.start()
        self._hilos.append(hilo_ping)

        # Notificar UI si existe callback
        if self.en_callback_estado:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.en_callback_estado({"evento": "partida_iniciada"})

    # -----------------------------------------------------------------------
    # Bucle de escucha por cliente
    # -----------------------------------------------------------------------

    def _escuchar_cliente(self, jugador_id: str, sock: socket.socket):  # Define una función o método
        """
        Hilo dedicado a leer mensajes de un cliente específico.

        Procesa TIPO_MOVIMIENTO, TIPO_RENUNCIA, TIPO_PONG y TIPO_CHAT.
        Al detectar desconexión, notifica al rival y finaliza la partida.

        Args:
            jugador_id (str)           : Identificador del jugador ("jugador_1/2").
            sock       (socket.socket) : Socket del cliente.
        """
        log.info(f"Hilo de escucha iniciado para {jugador_id}.")

        while self._partida_activa:  # Repite el bloque mientras la condición sea verdadera
            try:  # Intenta ejecutar el bloque; captura errores si ocurren
                mensaje = leer_mensaje_completo(sock)

                if mensaje is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    # Desconexión limpia
                    self._manejar_desconexion(jugador_id, "Conexión cerrada.")
                    break  # Sale inmediatamente del bucle actual

                tipo = mensaje.get("tipo")

                if tipo == TIPO_MOVIMIENTO:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._procesar_movimiento(jugador_id, mensaje)
                elif tipo == TIPO_RENUNCIA:  # Condición alternativa si la anterior fue falsa
                    self._procesar_renuncia(jugador_id)
                    break  # Sale inmediatamente del bucle actual
                elif tipo == TIPO_PONG:  # Condición alternativa si la anterior fue falsa
                    self._clientes[jugador_id]["ultimo_pong"] = time.time()
                elif tipo == TIPO_CHAT:  # Condición alternativa si la anterior fue falsa
                    self._retransmitir_chat(jugador_id, mensaje)
                else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                    log.debug(f"Tipo desconocido '{tipo}' de {jugador_id}, ignorado.")

            except (ConnectionError, OSError) as exc:  # Captura y maneja el error producido en el bloque try
                self._manejar_desconexion(jugador_id, str(exc))
                break  # Sale inmediatamente del bucle actual
            except Exception as exc:  # Captura y maneja el error producido en el bloque try
                log.error(f"Error inesperado en hilo de {jugador_id}: {exc}")

        log.info(f"Hilo de escucha terminado para {jugador_id}.")

    # -----------------------------------------------------------------------
    # Procesadores de mensajes
    # -----------------------------------------------------------------------

    def _procesar_movimiento(self, jugador_id: str, mensaje: dict):  # Define una función o método
        """
        Valida y ejecuta el movimiento recibido de un cliente.

        Si el movimiento es válido, difunde el nuevo estado.
        Si genera victoria, envía el mensaje de fin de partida.

        Args:
            jugador_id (str)  : Quién envió el movimiento.
            mensaje    (dict) : Mensaje TIPO_MOVIMIENTO recibido.
        """
        with self._lock:  # Gestiona un recurso y lo cierra automáticamente al terminar
            if self.tablero_logica is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                # Sin lógica de juego: reenviar en modo espejo (para pruebas)
                self._difundir(
                    msg_actualizar(
                        {},
                        {"origen": mensaje.get("origen"), "destino": mensaje.get("destino")},
                    )
                )
                return  # Devuelve un valor y termina la función

            origen  = tuple(mensaje.get("origen",  [0, 0]))
            destino = tuple(mensaje.get("destino", [0, 0]))
            fila_o, col_o = origen
            fila_d, col_d = destino

            # Verificar turno
            estado = self.tablero_logica.estado
            if estado.get("jugador_activo") != jugador_id:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._enviar_a(
                    self._clientes[jugador_id]["sock"],
                    msg_error("No es tu turno."),
                )
                return  # Devuelve un valor y termina la función

            # Ejecutar en el tablero: primero seleccionar, luego mover
            pieza = self.tablero_logica.cuadricula[fila_o][col_o]
            if pieza is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._enviar_a(
                    self._clientes[jugador_id]["sock"],
                    msg_error("No hay pieza en el origen."),
                )
                return  # Devuelve un valor y termina la función

            seleccionada = self.tablero_logica.seleccionar_pieza(fila_o, col_o)
            if not seleccionada:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._enviar_a(
                    self._clientes[jugador_id]["sock"],
                    msg_error("No se puede seleccionar esa pieza."),
                )
                return  # Devuelve un valor y termina la función

            resultado = self.tablero_logica.intentar_movimiento(fila_d, col_d)

            if not resultado.get("valido"):  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._enviar_a(
                    self._clientes[jugador_id]["sock"],
                    msg_error("Movimiento inválido."),
                )
                return  # Devuelve un valor y termina la función

            # Difundir estado actualizado
            estado_serial = serializar_estado(self.tablero_logica)
            ultimo_mov = {"origen": list(origen), "destino": list(destino)}
            self._difundir(msg_actualizar(estado_serial, ultimo_mov))

            # Notificar a la UI del servidor para que actualice su tablero local
            if self.en_callback_estado:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.en_callback_estado({
                    "evento": "actualizar",
                    "estado": estado_serial,
                    "ultimo_movimiento": ultimo_mov,
                })

            # Verificar victoria
            if resultado.get("victoria"):  # Evalúa una condición; ejecuta el bloque si es verdadera
                ganador  = resultado.get("ganador", jugador_id)
                razon    = resultado.get("razon", "Dominación Rúnica")
                self._difundir(msg_victoria(ganador, razon))
                log.info(f"Victoria de {ganador}: {razon}")
                self._partida_activa = False

                if self.en_callback_estado:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self.en_callback_estado({
                        "evento": "victoria",
                        "ganador": ganador,
                        "razon": razon,
                    })

    def _procesar_renuncia(self, jugador_id: str):  # Define una función o método
        """
        Maneja la rendición voluntaria de un jugador.

        El rival es declarado ganador automáticamente.

        Args:
            jugador_id (str): Jugador que se rindió.
        """
        ganador = (
            JUGADOR_2_ID if jugador_id == JUGADOR_1_ID else JUGADOR_1_ID
        )
        log.info(f"{jugador_id} se rindió. Ganador: {ganador}")
        self._difundir(msg_victoria(ganador, "El rival se rindió."))
        self._partida_activa = False

    def _retransmitir_chat(self, origen_id: str, mensaje: dict):  # Define una función o método
        """
        Reenvía un mensaje de chat al jugador contrario.

        Args:
            origen_id (str)  : Jugador que envió el chat.
            mensaje   (dict) : Mensaje TIPO_CHAT original.
        """
        rival_id = (
            JUGADOR_2_ID if origen_id == JUGADOR_1_ID else JUGADOR_1_ID
        )
        if rival_id in self._clientes:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._enviar_a(self._clientes[rival_id]["sock"], mensaje)

    def _manejar_desconexion(self, jugador_id: str, razon: str):  # Define una función o método
        """
        Gestiona la desconexión inesperada de un jugador.

        Notifica al rival y termina la partida.

        Args:
            jugador_id (str): Jugador que se desconectó.
            razon      (str): Descripción de la causa.
        """
        if not self._partida_activa:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return  # ya se terminó, ignorar

        log.warning(f"{jugador_id} se desconectó: {razon}")
        ganador = (
            JUGADOR_2_ID if jugador_id == JUGADOR_1_ID else JUGADOR_1_ID
        )
        self._difundir(msg_victoria(ganador, f"El rival se desconectó: {razon}"))
        self._partida_activa = False

        if self.en_callback_estado:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.en_callback_estado({
                "evento": "desconexion",
                "jugador": jugador_id,
                "ganador": ganador,
            })

    # -----------------------------------------------------------------------
    # Ping / keepalive
    # -----------------------------------------------------------------------

    def _bucle_ping(self):  # Define una función o método
        """
        Envía pings periódicos a ambos clientes para detectar desconexiones
        silenciosas (ej.: cable desconectado, proceso zombie).

        Si un cliente no responde con PONG en TIMEOUT_PING segundos,
        se le considera desconectado.
        """
        while self._partida_activa:  # Repite el bloque mientras la condición sea verdadera
            time.sleep(INTERVALO_PING)
            if not self._partida_activa:  # Evalúa una condición; ejecuta el bloque si es verdadera
                break  # Sale inmediatamente del bucle actual

            ahora = time.time()
            for jugador_id, info in list(self._clientes.items()):  # Repite el bloque por cada elemento del iterable
                if not info.get("vivo", True):  # Evalúa una condición; ejecuta el bloque si es verdadera
                    continue  # Salta a la siguiente iteración del bucle
                # Verificar timeout del último pong
                if ahora - info.get("ultimo_pong", ahora) > TIMEOUT_PING + INTERVALO_PING:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._manejar_desconexion(
                        jugador_id, "Timeout de ping (sin respuesta)."
                    )
                    continue  # Salta a la siguiente iteración del bucle
                self._enviar_a(info["sock"], msg_ping())

    # -----------------------------------------------------------------------
    # Utilidades de envío
    # -----------------------------------------------------------------------

    def _enviar_a(self, sock: socket.socket, mensaje: dict):  # Define una función o método
        """
        Envía un mensaje a un socket específico de forma segura.

        Args:
            sock    (socket.socket): Destino.
            mensaje (dict)         : Mensaje a enviar.
        """
        try:  # Intenta ejecutar el bloque; captura errores si ocurren
            sock.sendall(serializar_mensaje(mensaje))
        except OSError as exc:  # Captura y maneja el error producido en el bloque try
            log.debug(f"No se pudo enviar a socket: {exc}")

    def _difundir(self, mensaje: dict):  # Define una función o método
        """
        Envía el mismo mensaje a todos los clientes conectados.

        Args:
            mensaje (dict): Mensaje a difundir.
        """
        paquete = serializar_mensaje(mensaje)
        for info in self._clientes.values():  # Repite el bloque por cada elemento del iterable
            try:  # Intenta ejecutar el bloque; captura errores si ocurren
                info["sock"].sendall(paquete)
            except OSError as exc:  # Captura y maneja el error producido en el bloque try
                log.debug(f"No se pudo difundir: {exc}")


# ---------------------------------------------------------------------------
# Función auxiliar de serialización del estado
# ---------------------------------------------------------------------------

def serializar_estado(tablero) -> dict:  # Define una función o método
    """
    Convierte un objeto Tablero completo a un diccionario JSON-serializable.

    Serializa tanto la cuadricula (objetos Pieza) como los contadores de
    estado del juego en un dict con solo tipos primitivos.

    Args:
        tablero: Instancia de Tablero con atributos cuadricula y estado.

    Returns:
        dict: Estado serializable listo para enviar por red.
    """
    cuadricula_serial = []
    for fila in tablero.cuadricula:  # Repite el bloque por cada elemento del iterable
        fila_serial = []
        for celda in fila:  # Repite el bloque por cada elemento del iterable
            if celda is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                fila_serial.append(None)
            else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                fila_serial.append({
                    "tipo":    celda.tipo,
                    "jugador": celda.jugador,
                    "fila":    celda.fila,
                    "columna": celda.columna,
                    "movida":  celda.movida,
                    "energia": celda.energia,
                })
        cuadricula_serial.append(fila_serial)

    estado = tablero.estado
    return {  # Devuelve un valor y termina la función
        "jugador_activo":     estado.get("jugador_activo"),
        "capturas_j1":        estado.get("capturas_j1", 0),
        "capturas_j2":        estado.get("capturas_j2", 0),
        "energia_j1":         estado.get("energia_j1",  0),
        "energia_j2":         estado.get("energia_j2",  0),
        "guardian_capturado": estado.get("guardian_capturado"),
        "turno_numero":       estado.get("turno_numero", 1),
        "cuadricula":         cuadricula_serial,
    }


# ---------------------------------------------------------------------------
# Utilidad interna
# ---------------------------------------------------------------------------

def _cerrar_socket_seguro(sock: socket.socket):  # Define una función o método
    """
    Cierra un socket ignorando errores si ya estaba cerrado.

    Args:
        sock (socket.socket): Socket a cerrar.
    """
    try:  # Intenta ejecutar el bloque; captura errores si ocurren
        sock.shutdown(socket.SHUT_RDWR)
    except OSError:  # Captura y maneja el error producido en el bloque try
        pass  # No hace nada; marcador de bloque vacío
    try:  # Intenta ejecutar el bloque; captura errores si ocurren
        sock.close()
    except OSError:  # Captura y maneja el error producido en el bloque try
        pass  # No hace nada; marcador de bloque vacío


