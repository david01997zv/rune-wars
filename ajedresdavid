class Hexblade(Pieza):  # Define una clase (plantilla para crear objetos)
    """
    Hexblade — pieza de salto; equivale al Caballo de ajedrez.

    Movimiento: salto en L estándar (2+1 o 1+2), ignora piezas intermedias.
    Puede capturar enemigos en el destino del salto.
    """

    # Saltos de caballo estándar
    _SALTOS = [
        (-2, -1), (-2, 1), (2, -1), (2, 1),
        (-1, -2), (-1, 2), (1, -2), (1, 2),
    ]

    def __init__(self, jugador: str, fila: int, columna: int) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa el Hexblade en la posicion indicada.

        Args:
            jugador (str): Propietario de la pieza.
            fila    (int): Fila inicial.
            columna (int): Columna inicial.
        """
        super().__init__(HEXBLADE, jugador, fila, columna)

    def movimientos_validos(self, cuadricula: list) -> list[tuple[int, int]]:  # Define una función o método
        """
        Calcula los saltos en L del Hexblade (8 destinos posibles en L).

        Salta en L ignorando piezas intermedias. No puede aterrizar
        sobre aliados; sí puede capturar enemigos en el destino.

        Args:
            cuadricula (list): Estado actual del tablero.

        Returns:
            list[tuple[int,int]]: Casillas alcanzables.
        """
        movimientos = []
        for df, dc in self._SALTOS:  # Repite el bloque por cada elemento del iterable
            f, c = self.fila + df, self.columna + dc
            if not self._dentro_tablero(f, c):  # Evalúa una condición; ejecuta el bloque si es verdadera
                continue  # Salta a la siguiente iteración del bucle
            if self._es_aliado(cuadricula, f, c):  # Evalúa una condición; ejecuta el bloque si es verdadera
                continue  # Salta a la siguiente iteración del bucle
            movimientos.append((f, c))
        return movimientos  # Devuelve un valor y termina la función


class RunePawn(Pieza):  # Define una clase (plantilla para crear objetos)
    """
    RunePawn — peón rúnico; equivale al Peón con transformación.

    Movimiento: avanza 1 casilla (o 2 desde posición inicial).
    Captura: en diagonal hacia adelante.
    Transformación: al alcanzar la fila extrema se convierte en Invoker.
    """

    def __init__(self, jugador: str, fila: int, columna: int) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa el RunePawn en la posicion indicada.

        Args:
            jugador (str): Propietario de la pieza.
            fila    (int): Fila inicial.
            columna (int): Columna inicial.
        """
        super().__init__(RUNE_PAWN, jugador, fila, columna)

    def movimientos_validos(self, cuadricula: list) -> list[tuple[int, int]]:  # Define una función o método
        """
        Calcula los movimientos del RunePawn según su dirección.

        Args:
            cuadricula (list): Estado actual del tablero.

        Returns:
            list[tuple[int,int]]: Casillas alcanzables.
        """
        movimientos = []
        # Dirección: jugador_1 avanza hacia filas menores (arriba en pantalla)
        direccion = -1 if self.jugador == JUGADOR_1 else 1

        # Avance simple
        f1 = self.fila + direccion
        if self._dentro_tablero(f1, self.columna) and cuadricula[f1][self.columna] is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            movimientos.append((f1, self.columna))

            # Avance doble desde posición inicial
            if not self.movida:  # Evalúa una condición; ejecuta el bloque si es verdadera
                f2 = self.fila + 2 * direccion
                if self._dentro_tablero(f2, self.columna) and cuadricula[f2][self.columna] is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    movimientos.append((f2, self.columna))

        # Capturas diagonales
        for dc in [-1, 1]:  # Repite el bloque por cada elemento del iterable
            fc, cc = self.fila + direccion, self.columna + dc
            if self._dentro_tablero(fc, cc) and self._es_enemigo(cuadricula, fc, cc):  # Evalúa una condición; ejecuta el bloque si es verdadera
                movimientos.append((fc, cc))

        return movimientos  # Devuelve un valor y termina la función


