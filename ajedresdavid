class LobbyInvitado:  # Define una clase (plantilla para crear objetos)
    """
    Pantalla de conexión para el jugador que se une a una sala existente.

    Permite:
        - Ingresar IP y puerto del servidor.
        - Ingresar un alias de jugador.
        - Ver el estado de la conexión en tiempo real.
        - Chat mientras se espera el inicio de la partida.
        - Botón «Conectar» y «Cancelar».

    Args:
        ventana        (pygame.Surface): Ventana principal.
        fuentes        (dict)          : Diccionario con fuentes.
        nombre_default (str)           : Alias por defecto.
    """

    def __init__(  # Constructor: inicializa el objeto al crearlo
        self,
        ventana: pygame.Surface,
        fuentes: dict,
        nombre_default: str = "Invitado",
    ):
        self._ventana = ventana
        self._fuentes = fuentes

        self._cliente: Cliente | None = None
        self._accion = None
        self._reloj  = pygame.time.Clock()
        self._estado_texto = "Ingresa la IP y el puerto del servidor."
        self._mensajes_chat: list[str] = []
        self._chat_lock = threading.Lock()

        # Fuentes de respaldo
        f_normal  = fuentes.get("normal")  or pygame.font.SysFont("Arial", 20)
        f_pequena = fuentes.get("pequeña") or pygame.font.SysFont("Arial", 16)

        # Campos de texto
        self._campo_ip = _CampoTexto(
            pygame.Rect(_LOBBY_ANCHO // 2 - 160, 175, 320, 40),
            f_normal, maximo=40, placeholder="192.168.1.X",
        )
        self._campo_puerto = _CampoTexto(
            pygame.Rect(_LOBBY_ANCHO // 2 - 80, 245, 160, 40),
            f_normal, maximo=6, placeholder="5555",
        )
        self._campo_nombre = _CampoTexto(
            pygame.Rect(_LOBBY_ANCHO // 2 - 120, 315, 240, 40),
            f_normal, maximo=20, placeholder=nombre_default,
        )
        self._campo_chat = _CampoTexto(
            pygame.Rect(_LOBBY_MARGEN, _LOBBY_ALTO - 130, _LOBBY_ANCHO - _LOBBY_MARGEN * 2 - 110, 40),
            f_pequena, maximo=100, placeholder="Escribe un mensaje…",
        )

        # Botones
        self._btn_conectar = _Boton(
            pygame.Rect(_LOBBY_ANCHO // 2 - 100, 375, 200, 44), "Conectar", f_normal
        )
        self._btn_cancelar = _Boton(
            pygame.Rect(_LOBBY_MARGEN, _LOBBY_ALTO - 70, 120, 38), "← Menú", f_normal
        )
        self._btn_enviar_chat = _Boton(
            pygame.Rect(_LOBBY_ANCHO - _LOBBY_MARGEN - 100, _LOBBY_ALTO - 130, 95, 40),
            "Enviar", f_pequena,
        )

        self._conectando = False

    # --- Ciclo principal ---------------------------------------------------

    def ejecutar(self) -> str:  # Define una función o método
        """
        Bucle principal de la pantalla de lobby del invitado.

        Returns:
            str: ACCION_INICIAR_PARTIDA o ACCION_MENU.
        """
        while self._accion is None:  # Repite el bloque mientras la condición sea verdadera
            self._reloj.tick(_LOBBY_FPS)
            for evento in pygame.event.get():  # Repite el bloque por cada elemento del iterable
                if evento.type == pygame.QUIT:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._accion = ACCION_MENU

                # Campos de texto (solo cuando no estamos conectados)
                if not self._conectando:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._campo_ip.manejar_evento(evento)
                    self._campo_puerto.manejar_evento(evento)
                    self._campo_nombre.manejar_evento(evento)

                # Chat siempre disponible si hay cliente
                if self._cliente and self._cliente.conectado:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._campo_chat.manejar_evento(evento)
                    if (  # Evalúa una condición; ejecuta el bloque si es verdadera
                        evento.type == pygame.KEYDOWN
                        and evento.key == pygame.K_RETURN
                        and self._campo_chat.activo
                    ):
                        self._enviar_chat()
                    if self._btn_enviar_chat.fue_clicado(evento):  # Evalúa una condición; ejecuta el bloque si es verdadera
                        self._enviar_chat()

                # Botones principales
                if self._btn_cancelar.fue_clicado(evento):  # Evalúa una condición; ejecuta el bloque si es verdadera
                    if self._cliente:  # Evalúa una condición; ejecuta el bloque si es verdadera
                        self._cliente.desconectar()
                    self._accion = ACCION_MENU

                if self._btn_conectar.fue_clicado(evento) and not self._conectando:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._intentar_conectar()

            self._dibujar()

        return self._accion  # Devuelve un valor y termina la función

    # --- Conexión en hilo -------------------------------------------------

    def _intentar_conectar(self):  # Define una función o método
        """
        Lanza un hilo de conexión para no bloquear la UI durante el intento.
        """
        ip     = self._campo_ip.texto.strip() or "127.0.0.1"
        puerto_str = self._campo_puerto.texto.strip() or "5555"
        nombre = self._campo_nombre.texto.strip() or "Invitado"

        try:  # Intenta ejecutar el bloque; captura errores si ocurren
            puerto = int(puerto_str)
        except ValueError:  # Captura y maneja el error producido en el bloque try
            self._estado_texto = "Puerto inválido. Ingresa un número."
            return  # Devuelve un valor y termina la función

        self._conectando   = True
        self._estado_texto = f"Conectando a {ip}:{puerto}…"

        self._cliente = Cliente(
            ip=ip,
            puerto=puerto,
            nombre_jugador=nombre,
            en_actualizar   = self._on_actualizar,
            en_victoria     = self._on_victoria,
            en_error        = self._on_error,
            en_sala_lista   = self._on_sala_lista,
            en_chat         = self._on_chat,
        )

        hilo = threading.Thread(target=self._hilo_conexion, daemon=True)
        hilo.start()

    def _hilo_conexion(self):  # Define una función o método
        """
        Ejecuta la conexión en segundo plano.
        NO arranca el hilo de escucha aquí; lo hace main() después de
        registrar los callbacks del Juego con configurar_red().
        """
        exito = self._cliente.conectar()
        if exito:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._estado_texto = "Conectado. Esperando inicio de partida…"
            # Señalar al lobby que puede mostrar "listo" y esperar inicio
            self._accion = ACCION_INICIAR_PARTIDA
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            self._estado_texto = "No se pudo conectar. Verifica IP y puerto."
            self._conectando = False

    # --- Callbacks del cliente --------------------------------------------

    def _on_sala_lista(self, jugador_id: str, rival_nombre: str):  # Define una función o método
        self._estado_texto = (
            f"Sala completa. Eres '{jugador_id}'. "
            f"Rival: {rival_nombre}"
        )
        self._agregar_chat("Sistema", f"¡{rival_nombre} está en la sala!")

    def _on_actualizar(self, estado: dict, ultimo_mov: dict):  # Define una función o método
        # Este callback ya no se usa para salir del lobby.
        # El lobby sale en _hilo_conexion apenas recibe SALA_LISTA.
        self._estado_texto = f"Turno {estado.get('turno_numero', '?')}"

    def _on_victoria(self, ganador: str, razon: str):  # Define una función o método
        self._estado_texto = f"Partida terminada. Ganador: {ganador}"
        self._accion = ACCION_INICIAR_PARTIDA

    def _on_error(self, descripcion: str):  # Define una función o método
        self._estado_texto = f"Error: {descripcion}"
        self._conectando = False

    def _on_chat(self, nombre: str, texto: str):  # Define una función o método
        self._agregar_chat(nombre, texto)

    # --- Chat -------------------------------------------------------------

    def _agregar_chat(self, nombre: str, texto: str):  # Define una función o método
        """
        Agrega una línea al historial de chat.

        Args:
            nombre (str): Remitente.
            texto  (str): Contenido.
        """
        with self._chat_lock:  # Gestiona un recurso y lo cierra automáticamente al terminar
            self._mensajes_chat.append(f"{nombre}: {texto}")
            if len(self._mensajes_chat) > _LOBBY_MAX_CHAT:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._mensajes_chat.pop(0)

    def _enviar_chat(self):  # Define una función o método
        """Envía el texto del campo de chat al servidor."""
        texto = self._campo_chat.texto.strip()
        if texto and self._cliente:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._cliente.enviar_chat(texto)
            nombre = self._campo_nombre.texto.strip() or "Yo"
            self._agregar_chat(nombre, texto)
            self._campo_chat.texto = ""

    # --- Renderizado -------------------------------------------------------

    def _dibujar(self):  # Define una función o método
        """Dibuja la pantalla completa del lobby del invitado."""
        ventana = self._ventana
        ventana.fill(_LOBBY_COLOR_FONDO)

        f_titulo  = self._fuentes.get("titulo")  or pygame.font.SysFont("Arial", 34, bold=True)
        f_normal  = self._fuentes.get("normal")  or pygame.font.SysFont("Arial", 20)
        f_pequena = self._fuentes.get("pequeña") or pygame.font.SysFont("Arial", 16)

        # Título
        _dibujar_texto_centrado(ventana, "⚔  Rune Wars — Unirse a Partida  ⚔",
                                f_titulo, _LOBBY_COLOR_TITULO, _LOBBY_ANCHO // 2, 50)

        # Etiquetas de campos (solo si no está conectando)
        if not self._conectando:  # Evalúa una condición; ejecuta el bloque si es verdadera
            _dibujar_texto_izq(ventana, "Dirección IP del servidor:",
                               f_pequena, _LOBBY_COLOR_TEXTO_DIM, _LOBBY_ANCHO // 2 - 160, 158)
            self._campo_ip.dibujar(ventana)

            _dibujar_texto_izq(ventana, "Puerto:",
                               f_pequena, _LOBBY_COLOR_TEXTO_DIM, _LOBBY_ANCHO // 2 - 80, 228)
            self._campo_puerto.dibujar(ventana)

            _dibujar_texto_izq(ventana, "Tu nombre:",
                               f_pequena, _LOBBY_COLOR_TEXTO_DIM, _LOBBY_ANCHO // 2 - 120, 298)
            self._campo_nombre.dibujar(ventana)

            self._btn_conectar.dibujar(ventana)

        # Estado de conexión
        color_estado = _LOBBY_COLOR_VERDE_RUN if "Conectado" in self._estado_texto else _LOBBY_COLOR_TEXTO
        if "Error" in self._estado_texto or "inválido" in self._estado_texto:  # Evalúa una condición; ejecuta el bloque si es verdadera
            color_estado = _LOBBY_COLOR_ROJO_RUN
        _dibujar_texto_centrado(ventana, self._estado_texto,
                                f_normal, color_estado, _LOBBY_ANCHO // 2, 435)

        # Panel de chat (solo si hay cliente activo)
        if self._cliente and self._cliente.conectado:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._dibujar_chat(ventana, f_pequena)

        # Botón cancelar
        self._btn_cancelar.dibujar(ventana)

        pygame.display.flip()

    def _dibujar_chat(self, ventana: pygame.Surface, fuente):  # Define una función o método
        """
        Dibuja el panel de chat en la parte inferior de la pantalla.

        Args:
            ventana (pygame.Surface): Destino de renderizado.
            fuente  (pygame.Font)   : Fuente pequeña para el chat.
        """
        panel_chat = pygame.Rect(_LOBBY_MARGEN, _LOBBY_ALTO - 200, _LOBBY_ANCHO - _LOBBY_MARGEN * 2, 65)
        pygame.draw.rect(ventana, _LOBBY_COLOR_CHAT_FONDO, panel_chat, border_radius=8)
        pygame.draw.rect(ventana, _LOBBY_COLOR_SEPARADOR,  panel_chat, 1, border_radius=8)

        with self._chat_lock:  # Gestiona un recurso y lo cierra automáticamente al terminar
            msgs = list(self._mensajes_chat[-3:])

        y = _LOBBY_ALTO - 198
        for msg in msgs:  # Repite el bloque por cada elemento del iterable
            surf = fuente.render(msg[:80], True, _LOBBY_COLOR_TEXTO)
            ventana.blit(surf, (_LOBBY_MARGEN + 10, y))
            y += 20

        self._campo_chat.dibujar(ventana)
        self._btn_enviar_chat.dibujar(ventana)


