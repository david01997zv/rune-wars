# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# logging ya configurado por el módulo servidor
log_cliente = logging.getLogger("cliente")


# ---------------------------------------------------------------------------
# Estados internos del cliente
# ---------------------------------------------------------------------------
ESTADO_DESCONECTADO = "desconectado"
ESTADO_CONECTANDO   = "conectando"
ESTADO_EN_LOBBY     = "en_lobby"
ESTADO_EN_PARTIDA   = "en_partida"
ESTADO_FINALIZADO   = "finalizado"


class Cliente:  # Define una clase (plantilla para crear objetos)
    """
    Cliente de red para Rune Wars (1v1 remoto).

    Gestiona la conexión TCP con el servidor, el envío de acciones del
    jugador local y la recepción de actualizaciones del tablero.

    Attributes:
        ip              (str)  : IP o hostname del servidor.
        puerto          (int)  : Puerto TCP del servidor.
        nombre_jugador  (str)  : Alias del jugador local.
        jugador_id      (str)  : "jugador_1" o "jugador_2" asignado por el servidor.
        rival_nombre    (str)  : Nombre del oponente.
        estado_cliente  (str)  : Estado actual (ver constantes ESTADO_*).
        estado_juego    (dict) : Último estado del tablero recibido.
        en_actualizar   (Callable | None): Callback(estado_juego, ultimo_mov).
        en_victoria     (Callable | None): Callback(ganador, razon).
        en_error        (Callable | None): Callback(descripcion).
        en_sala_lista   (Callable | None): Callback(jugador_id, rival_nombre).
        en_chat         (Callable | None): Callback(nombre, texto).
    """

    def __init__(  # Constructor: inicializa el objeto al crearlo
        self,
        ip: str,
        puerto: int,
        nombre_jugador: str = "Jugador",
        en_actualizar:  Callable | None = None,
        en_victoria:    Callable | None = None,
        en_error:       Callable | None = None,
        en_sala_lista:  Callable | None = None,
        en_chat:        Callable | None = None,
    ):
        """
        Inicializa el cliente sin establecer la conexión todavía.

        Args:
            ip              (str)      : Dirección IP del servidor.
            puerto          (int)      : Puerto TCP.
            nombre_jugador  (str)      : Alias visible del jugador.
            en_actualizar   (Callable) : Llamado al recibir TIPO_ACTUALIZAR.
                                         Firma: fn(estado: dict, ultimo_mov: dict).
            en_victoria     (Callable) : Llamado al recibir TIPO_VICTORIA.
                                         Firma: fn(ganador: str, razon: str).
            en_error        (Callable) : Llamado al recibir TIPO_ERROR o desconexión.
                                         Firma: fn(descripcion: str).
            en_sala_lista   (Callable) : Llamado cuando la sala está completa.
                                         Firma: fn(jugador_id: str, rival_nombre: str).
            en_chat         (Callable) : Llamado al recibir un mensaje de chat.
                                         Firma: fn(nombre: str, texto: str).
        """
        self.ip = ip
        self.puerto = puerto
        self.nombre_jugador = nombre_jugador[:20]

        self.jugador_id    = ""
        self.rival_nombre  = ""
        self.estado_cliente = ESTADO_DESCONECTADO
        self.estado_juego  = {}

        # Callbacks
        self.en_actualizar  = en_actualizar
        self.en_victoria    = en_victoria
        self.en_error       = en_error
        self.en_sala_lista  = en_sala_lista
        self.en_chat        = en_chat

        self._sock: socket.socket | None = None
        self._hilo_recepcion: threading.Thread | None = None
        self._lock = threading.Lock()

    # -----------------------------------------------------------------------
    # Conexión
    # -----------------------------------------------------------------------

    def conectar(self, timeout: float = 15.0) -> bool:  # Define una función o método
        """
        Establece la conexión TCP con el servidor y realiza el handshake
        inicial (UNIRSE → esperar SALA_LISTA).

        Bloquea hasta recibir la confirmación de sala o hasta que se
        agote el tiempo de espera.

        Args:
            timeout (float): Segundos máximos de espera para el handshake.

        Returns:
            bool: True si la conexión y el handshake fueron exitosos.
        """
        self.estado_cliente = ESTADO_CONECTANDO
        log_cliente.info(f"Conectando a {self.ip}:{self.puerto}…")

        try:  # Intenta ejecutar el bloque; captura errores si ocurren
            self._sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            self._sock.settimeout(timeout)
            self._sock.connect((self.ip, self.puerto))
            log.info("Conexión TCP establecida.")

            # Enviar presentación
            self._enviar(msg_unirse(self.nombre_jugador))

            # Esperar confirmación de sala
            if not self._esperar_sala_lista(timeout):  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.desconectar("No se recibió confirmación de sala.")
                return False  # Devuelve un valor y termina la función

            self.estado_cliente = ESTADO_EN_LOBBY
            self._sock.settimeout(None)   # modo bloqueante para el hilo
            return True  # Devuelve un valor y termina la función

        except (OSError, TimeoutError, ConnectionRefusedError) as exc:  # Captura y maneja el error producido en el bloque try
            log.error(f"No se pudo conectar: {exc}")
            self.estado_cliente = ESTADO_DESCONECTADO
            if self.en_error:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.en_error(f"Error de conexión: {exc}")
            return False  # Devuelve un valor y termina la función

    def _esperar_sala_lista(self, timeout: float) -> bool:  # Define una función o método
        """
        Espera el mensaje TIPO_SALA_LISTA del servidor para conocer el
        rol asignado y el nombre del rival.

        También puede recibir TIPO_INICIO si el servidor lo envía
        inmediatamente (sólo 1 mensaje de espera).

        Args:
            timeout (float): Límite en segundos.

        Returns:
            bool: True si se recibió la confirmación correctamente.
        """
        deadline = time.time() + timeout
        while time.time() < deadline:  # Repite el bloque mientras la condición sea verdadera
            try:  # Intenta ejecutar el bloque; captura errores si ocurren
                mensaje = leer_mensaje_completo(self._sock)
                if mensaje is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    return False  # Devuelve un valor y termina la función
                tipo = mensaje.get("tipo")

                if tipo == TIPO_SALA_LISTA:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self.jugador_id   = mensaje.get("jugador_asignado", "jugador_1")
                    self.rival_nombre = mensaje.get("rival_nombre", "Rival")
                    log.info(
                        f"Sala confirmada. Soy '{self.jugador_id}', "
                        f"rival: '{self.rival_nombre}'"
                    )
                    if self.en_sala_lista:  # Evalúa una condición; ejecuta el bloque si es verdadera
                        self.en_sala_lista(self.jugador_id, self.rival_nombre)
                    return True  # Devuelve un valor y termina la función

            except Exception as exc:  # Captura y maneja el error producido en el bloque try
                log.warning(f"Error esperando sala: {exc}")
                return False  # Devuelve un valor y termina la función

        return False  # Devuelve un valor y termina la función

    # -----------------------------------------------------------------------
    # Bucle de recepción
    # -----------------------------------------------------------------------

    def iniciar_escucha(self):  # Define una función o método
        """
        Lanza el hilo de recepción de mensajes del servidor.

        No bloqueante. El hilo corre en modo daemon para no impedir
        que el proceso principal termine.
        """
        if self._hilo_recepcion and self._hilo_recepcion.is_alive():  # Evalúa una condición; ejecuta el bloque si es verdadera
            log.warning("El hilo de escucha ya está activo.")
            return  # Devuelve un valor y termina la función

        self._hilo_recepcion = threading.Thread(
            target=self._bucle_recepcion, daemon=True
        )
        self._hilo_recepcion.start()
        log_cliente.info("Hilo de recepción iniciado.")

    def _bucle_recepcion(self):  # Define una función o método
        """
        Hilo interno que lee mensajes del servidor de forma continua
        y los despacha a los manejadores correspondientes.
        """
        while self.estado_cliente in (ESTADO_EN_LOBBY, ESTADO_EN_PARTIDA):  # Repite el bloque mientras la condición sea verdadera
            try:  # Intenta ejecutar el bloque; captura errores si ocurren
                mensaje = leer_mensaje_completo(self._sock)

                if mensaje is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._manejar_desconexion_servidor("Conexión cerrada por el servidor.")
                    break  # Sale inmediatamente del bucle actual

                self._despachar_mensaje(mensaje)

            except (ConnectionError, OSError) as exc:  # Captura y maneja el error producido en el bloque try
                if self.estado_cliente not in (ESTADO_DESCONECTADO, ESTADO_FINALIZADO):  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._manejar_desconexion_servidor(str(exc))
                break  # Sale inmediatamente del bucle actual
            except Exception as exc:  # Captura y maneja el error producido en el bloque try
                log.error(f"Error inesperado en recepción: {exc}")

        log_cliente.info("Hilo de recepción finalizado.")

    def _despachar_mensaje(self, mensaje: dict):  # Define una función o método
        """
        Enruta un mensaje recibido al manejador adecuado según su tipo.

        Args:
            mensaje (dict): Mensaje deserializado del servidor.
        """
        tipo = mensaje.get("tipo")

        if tipo == TIPO_INICIO:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.estado_juego   = mensaje.get("estado", {})
            self.estado_cliente = ESTADO_EN_PARTIDA
            log.info("Partida iniciada por el servidor.")
            # Sincronizar el tablero local con el estado inicial del servidor
            if self.en_actualizar:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.en_actualizar(self.estado_juego, {})

        elif tipo == TIPO_ACTUALIZAR:  # Condición alternativa si la anterior fue falsa
            with self._lock:  # Gestiona un recurso y lo cierra automáticamente al terminar
                self.estado_juego = mensaje.get("estado", {})
            ultimo_mov = mensaje.get("ultimo_movimiento", {})
            log.debug(f"Estado actualizado. Turno: {self.estado_juego.get('turno_numero')}")
            if self.en_actualizar:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.en_actualizar(self.estado_juego, ultimo_mov)

        elif tipo == TIPO_VICTORIA:  # Condición alternativa si la anterior fue falsa
            ganador = mensaje.get("ganador", "")
            razon   = mensaje.get("razon", "")
            log.info(f"Victoria recibida: {ganador} — {razon}")
            self.estado_cliente = ESTADO_FINALIZADO
            if self.en_victoria:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.en_victoria(ganador, razon)

        elif tipo == TIPO_PING:  # Condición alternativa si la anterior fue falsa
            self._enviar(msg_pong())

        elif tipo == TIPO_ERROR:  # Condición alternativa si la anterior fue falsa
            desc = mensaje.get("descripcion", "Error desconocido")
            log.warning(f"Error del servidor: {desc}")
            if self.en_error:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.en_error(desc)

        elif tipo == TIPO_CHAT:  # Condición alternativa si la anterior fue falsa
            nombre = mensaje.get("nombre", "?")
            texto  = mensaje.get("texto", "")
            if self.en_chat:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.en_chat(nombre, texto)

        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            log.debug(f"Tipo de mensaje no manejado: '{tipo}'")

    # -----------------------------------------------------------------------
    # Acciones del jugador
    # -----------------------------------------------------------------------

    def enviar_movimiento(self, origen: tuple, destino: tuple) -> bool:  # Define una función o método
        """
        Envía un movimiento al servidor si es el turno del jugador local.

        Args:
            origen  (tuple): (fila, columna) de la pieza a mover.
            destino (tuple): (fila, columna) del destino deseado.

        Returns:
            bool: True si el mensaje fue enviado, False si hubo error.
        """
        if self.estado_cliente != ESTADO_EN_PARTIDA:  # Evalúa una condición; ejecuta el bloque si es verdadera
            log.warning("Intento de mover fuera de partida.")
            return False  # Devuelve un valor y termina la función

        turno_actual = self.estado_juego.get("jugador_activo", "")
        if turno_actual != self.jugador_id:  # Evalúa una condición; ejecuta el bloque si es verdadera
            log.info("No es tu turno; movimiento ignorado localmente.")
            return False  # Devuelve un valor y termina la función

        return self._enviar(msg_movimiento(origen, destino, self.jugador_id))  # Devuelve un valor y termina la función

    def rendirse(self) -> bool:  # Define una función o método
        """
        Envía mensaje de renuncia al servidor.

        Returns:
            bool: True si el mensaje fue enviado.
        """
        log_cliente.info(f"{self.nombre_jugador} se rinde.")
        return self._enviar(msg_renuncia(self.jugador_id))  # Devuelve un valor y termina la función

    def enviar_chat(self, texto: str) -> bool:  # Define una función o método
        """
        Envía un mensaje de chat al servidor (que lo retransmite al rival).

        Args:
            texto (str): Contenido del mensaje.

        Returns:
            bool: True si fue enviado.
        """
        return self._enviar(msg_chat(self.nombre_jugador, texto))  # Devuelve un valor y termina la función

    # -----------------------------------------------------------------------
    # Desconexión
    # -----------------------------------------------------------------------

    def desconectar(self, razon: str = "Desconexión voluntaria"):  # Define una función o método
        """
        Cierra la conexión con el servidor de forma limpia.

        Args:
            razon (str): Motivo de la desconexión (para el log).
        """
        log_cliente.info(f"Desconectando: {razon}")
        self.estado_cliente = ESTADO_DESCONECTADO
        if self._sock:  # Evalúa una condición; ejecuta el bloque si es verdadera
            _cerrar_socket_seguro(self._sock)
            self._sock = None

    def _manejar_desconexion_servidor(self, razon: str):  # Define una función o método
        """
        Reacciona ante una desconexión inesperada del servidor.

        Args:
            razon (str): Descripción de la causa.
        """
        log_cliente.warning(f"Desconexión del servidor: {razon}")
        self.estado_cliente = ESTADO_DESCONECTADO
        if self.en_error:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.en_error(f"Conexión perdida: {razon}")

    # -----------------------------------------------------------------------
    # Utilidad de envío
    # -----------------------------------------------------------------------

    def _enviar(self, mensaje: dict) -> bool:  # Define una función o método
        """
        Serializa y envía un mensaje al servidor de forma segura.

        Args:
            mensaje (dict): Mensaje a enviar.

        Returns:
            bool: True si fue enviado sin errores.
        """
        if self._sock is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return False  # Devuelve un valor y termina la función
        try:  # Intenta ejecutar el bloque; captura errores si ocurren
            self._sock.sendall(serializar_mensaje(mensaje))
            return True  # Devuelve un valor y termina la función
        except OSError as exc:  # Captura y maneja el error producido en el bloque try
            log.error(f"No se pudo enviar mensaje: {exc}")
            return False  # Devuelve un valor y termina la función

    # -----------------------------------------------------------------------
    # Propiedades de consulta
    # -----------------------------------------------------------------------

    @property
    def es_mi_turno(self) -> bool:  # Define una función o método
        """
        Indica si actualmente es el turno del jugador local.

        Returns:
            bool: True si jugador_activo en el estado coincide con jugador_id.
        """
        return self.estado_juego.get("jugador_activo") == self.jugador_id  # Devuelve un valor y termina la función

    @property
    def conectado(self) -> bool:  # Define una función o método
        """
        Indica si el cliente está conectado y en estado activo.

        Returns:
            bool: True si el estado no es DESCONECTADO ni FINALIZADO.
        """
        return self.estado_cliente in (ESTADO_EN_LOBBY, ESTADO_EN_PARTIDA)  # Devuelve un valor y termina la función



