_BOTONES = [
    {"clave": "local",    "etiqueta": "⚔  Jugar Local (2 jugadores)"},
    {"clave": "vs_pc",    "etiqueta": "🤖  Jugar vs PC"},
    {"clave": "servidor", "etiqueta": "🌐  Crear Partida (Red)"},
    {"clave": "cliente",  "etiqueta": "🔗  Unirse a Partida (Red)"},
    {"clave": "ficha",    "etiqueta": "📖  Ficha Técnica"},
    {"clave": "salir",    "etiqueta": "✕  Salir"},
]

_ANCHO_BOTON = 300
_ALTO_BOTON  = 50
_SEPARACION  = 16


class Menu:  # Define una clase (plantilla para crear objetos)
    """
    Menú principal de Rune Wars.

    Attributes:
        ventana  (pygame.Surface): Ventana principal de Pygame.
        fuentes  (dict)          : Diccionario de fuentes del juego.
        _tick    (int)           : Contador de frames para animaciones.
        _reloj   (pygame.time.Clock): Reloj de FPS.
        _botones (list)          : Lista de dicts con información de cada botón.
    """

    def __init__(self, ventana: pygame.Surface, fuentes: dict) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa el menú principal.

        Args:
            ventana (pygame.Surface): Ventana de Pygame.
            fuentes (dict)          : Fuentes precargadas del juego.
        """
        self.ventana = ventana
        self.fuentes = fuentes
        self._tick   = 0
        self._reloj  = pygame.time.Clock()
        self._botones: list[dict] = []
        self._construir_botones()

    def _construir_botones(self) -> None:  # Define una función o método
        """Calcula los rectángulos de cada botón y los almacena en self._botones."""
        totalAlto   = len(_BOTONES) * (_ALTO_BOTON + _SEPARACION) - _SEPARACION
        startY      = ALTO_VENTANA // 2 - totalAlto // 2 + 60
        cx          = ANCHO_VENTANA // 2

        self._botones = []
        for i, info in enumerate(_BOTONES):  # Repite el bloque por cada elemento del iterable
            y    = startY + i * (_ALTO_BOTON + _SEPARACION)
            rect = pygame.Rect(cx - _ANCHO_BOTON // 2, y, _ANCHO_BOTON, _ALTO_BOTON)
            self._botones.append({"clave": info["clave"], "etiqueta": info["etiqueta"], "rect": rect})

    # ------------------------------------------------------------------
    # Bucle del menú
    # ------------------------------------------------------------------

    def ejecutar(self) -> str:  # Define una función o método
        """
        Ejecuta el bucle del menú principal.

        Returns:
            str: Clave de la acción elegida ('local', 'servidor', 'cliente', 'salir').
        """
        while True:  # Repite el bloque mientras la condición sea verdadera
            self._reloj.tick(FPS)
            self._tick += 1

            for evento in pygame.event.get():  # Repite el bloque por cada elemento del iterable
                if evento.type == pygame.QUIT:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    return "salir"  # Devuelve un valor y termina la función

                if evento.type == pygame.KEYDOWN and evento.key == pygame.K_ESCAPE:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    return "salir"  # Devuelve un valor y termina la función

                if evento.type == pygame.MOUSEBUTTONDOWN and evento.button == 1:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    accion = self._manejar_click(evento.pos)
                    if accion == "ficha":  # Evalúa una condición; ejecuta el bloque si es verdadera
                        ficha = FichaTecnica(self.ventana, self.fuentes)
                        ficha.ejecutar()
                    elif accion is not None:  # Condición alternativa si la anterior fue falsa
                        return accion  # Devuelve un valor y termina la función

            self._dibujar()
            pygame.display.flip()

    def _manejar_click(self, pos: tuple) -> str | None:  # Define una función o método
        """
        Determina qué botón fue pulsado en la posición dada.

        Args:
            pos (tuple): Coordenadas (x, y) del click.

        Returns:
            str | None: Clave del botón pulsado o None si no hay coincidencia.
        """
        for boton in self._botones:  # Repite el bloque por cada elemento del iterable
            if boton["rect"].collidepoint(pos):  # Evalúa una condición; ejecuta el bloque si es verdadera
                return boton["clave"]  # Devuelve un valor y termina la función
        return None  # Devuelve un valor y termina la función

    # ------------------------------------------------------------------
    # Renderizado
    # ------------------------------------------------------------------

    def _dibujar(self) -> None:  # Define una función o método
        """Dibuja el menú completo en la ventana."""
        self.ventana.fill(COLOR_FONDO)
        self._dibujar_fondo_animado()
        self._dibujar_titulo()
        self._dibujar_botones()
        self._dibujar_creditos()

    def _dibujar_fondo_animado(self) -> None:  # Define una función o método
        """Dibuja partículas de runas flotantes en el fondo como decoración."""
        runas = ["✦", "✧", "⬡", "◈", "⬢"]
        for i in range(12):  # Repite el bloque por cada elemento del iterable
            angulo = (self._tick * 0.4 + i * 30) * math.pi / 180
            radio  = 180 + i * 22
            cx     = ANCHO_VENTANA // 2 + int(math.cos(angulo) * radio * 0.3)
            cy     = ALTO_VENTANA  // 2 + int(math.sin(angulo) * radio * 0.15)
            alpha  = int(30 + 20 * math.sin(self._tick * 0.03 + i))
            runa   = runas[i % len(runas)]
            surf   = self.fuentes["mediana"].render(runa, True, (*COLOR_RUNA_GLOW[:3],))
            surf.set_alpha(alpha)
            self.ventana.blit(surf, (cx, cy))

    def _dibujar_titulo(self) -> None:  # Define una función o método
        """Dibuja el título del juego con efecto de brillo pulsante."""
        cx = ANCHO_VENTANA // 2
        glowAlpha = int(180 + 60 * math.sin(self._tick * 0.04))

        # Sombra/glow
        surfGlow = self.fuentes["titulo"].render("RUNE WARS", True, COLOR_RUNA_GLOW)
        surfGlow.set_alpha(glowAlpha // 3)
        self.ventana.blit(surfGlow, (cx - surfGlow.get_width() // 2 + 3, 82))

        # Título principal
        surf = self.fuentes["titulo"].render("RUNE WARS", True, COLOR_TITULO)
        self.ventana.blit(surf, (cx - surf.get_width() // 2, 80))

        # Subtítulo
        surfSub = self.fuentes["pequena"].render(
            "Ajedrez de runas y magia — ITCR San Carlos", True, COLOR_TEXTO_DIM
        )
        self.ventana.blit(surfSub, (cx - surfSub.get_width() // 2, 138))

        # Línea decorativa
        pygame.draw.line(
            self.ventana, COLOR_BORDE_TABLERO,
            (cx - 160, 165), (cx + 160, 165), 1
        )

    def _dibujar_botones(self) -> None:  # Define una función o método
        """Dibuja los botones del menú con estado hover."""
        mouse = pygame.mouse.get_pos()

        for boton in self._botones:  # Repite el bloque por cada elemento del iterable
            rect      = boton["rect"]
            esHover   = rect.collidepoint(mouse)
            colorFondo = COLOR_BOTON_HOVER if esHover else COLOR_BOTON

            # Fondo del botón
            pygame.draw.rect(self.ventana, colorFondo, rect, border_radius=10)
            pygame.draw.rect(self.ventana, COLOR_BOTON_BORDE, rect, 2, border_radius=10)

            # Efecto de brillo en hover
            if esHover:  # Evalúa una condición; ejecuta el bloque si es verdadera
                surfGlow = pygame.Surface((rect.width, rect.height), pygame.SRCALPHA)
                surfGlow.fill((180, 140, 255, 25))
                self.ventana.blit(surfGlow, rect.topleft)

            # Texto del botón
            surfTexto = self.fuentes["mediana"].render(boton["etiqueta"], True, COLOR_TITULO)
            self.ventana.blit(
                surfTexto,
                (rect.centerx - surfTexto.get_width() // 2,
                 rect.centery - surfTexto.get_height() // 2),
            )

    def _dibujar_creditos(self) -> None:  # Define una función o método
        """Dibuja los créditos en la parte inferior de la pantalla."""
        surf = self.fuentes["pequena"].render(
            "David Zamora · Taller de Programación · ITCR 2026",
