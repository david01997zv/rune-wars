class _Boton:  # Define una clase (plantilla para crear objetos)
    """
    Botón rectangular con efecto hover.

    Args:
        rect      (pygame.Rect): Área del botón.
        texto     (str)        : Etiqueta visible.
        fuente    (pygame.Font): Fuente para el texto.
        activo    (bool)       : Si False, el botón se dibuja atenuado.
    """

    def __init__(self, rect: pygame.Rect, texto: str, fuente, activo: bool = True):  # Constructor: inicializa el objeto al crearlo
        self.rect   = rect
        self.texto  = texto
        self.fuente = fuente
        self.activo = activo

    def dibujar(self, superficie: pygame.Surface):  # Define una función o método
        """
        Renderiza el botón en la superficie dada.

        Args:
            superficie (pygame.Surface): Destino de renderizado.
        """
        hover = self.rect.collidepoint(pygame.mouse.get_pos()) and self.activo
        color_fondo = _LOBBY_COLOR_BTN_HOVER if hover else _LOBBY_COLOR_BTN_NORMAL
        if not self.activo:  # Evalúa una condición; ejecuta el bloque si es verdadera
            color_fondo = (30, 25, 55)

        pygame.draw.rect(superficie, color_fondo, self.rect, border_radius=8)
        pygame.draw.rect(superficie, _LOBBY_COLOR_BORDE,  self.rect, 2, border_radius=8)

        color_txt = _LOBBY_COLOR_BTN_TEXTO if self.activo else _LOBBY_COLOR_TEXTO_DIM
        texto_surf = self.fuente.render(self.texto, True, color_txt)
        texto_rect = texto_surf.get_rect(center=self.rect.center)
        superficie.blit(texto_surf, texto_rect)

    def fue_clicado(self, evento: pygame.event.Event) -> bool:  # Define una función o método
        """
        Verifica si el evento es un clic sobre este botón.

        Args:
            evento (pygame.event.Event): Evento de Pygame.

        Returns:
            bool: True si fue clic izquierdo dentro del área del botón.
        """
        return (  # Devuelve un valor y termina la función
            self.activo
            and evento.type == pygame.MOUSEBUTTONDOWN
            and evento.button == 1
            and self.rect.collidepoint(evento.pos)
        )


