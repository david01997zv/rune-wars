class Pieza:  # Define una clase (plantilla para crear objetos)
    """
    Clase base abstracta para todas las piezas de Rune Wars.

    Attributes:
        tipo        (str) : Identificador del tipo de pieza.
        jugador     (str) : JUGADOR_1 o JUGADOR_2.
        fila        (int) : Fila actual en el tablero (0 = arriba).
        columna     (int) : Columna actual en el tablero (0 = izquierda).
        movida      (bool): True si la pieza ya se movió al menos una vez.
        energia     (int) : Energía de runa acumulada (0-5).
    """

    def __init__(self, tipo: str, jugador: str, fila: int, columna: int) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa una pieza en una posición del tablero.

        Args:
            tipo    (str): Tipo de pieza (constante de constantes.py).
            jugador (str): Propietario de la pieza.
            fila    (int): Fila inicial.
            columna (int): Columna inicial.
        """
        self.tipo    = tipo
        self.jugador = jugador
        self.fila    = fila
        self.columna = columna
        self.movida  = False
        self.energia = 0

    # ------------------------------------------------------------------
    # Métodos de soporte
    # ------------------------------------------------------------------

    def _dentro_tablero(self, fila: int, columna: int) -> bool:  # Define una función o método
        """
        Verifica que una posición esté dentro de los límites del tablero.

        Args:
            fila    (int): Fila a verificar.
            columna (int): Columna a verificar.

        Returns:
            bool: True si la posición es válida.
        """
        return 0 <= fila < FILAS and 0 <= columna < COLUMNAS  # Devuelve un valor y termina la función

    def _es_enemigo(self, cuadricula: list, fila: int, columna: int) -> bool:  # Define una función o método
        """
        Indica si la casilla contiene una pieza enemiga.

        Args:
            cuadricula (list): Cuadrícula actual del tablero.
            fila       (int) : Fila a verificar.
            columna    (int) : Columna a verificar.

        Returns:
            bool: True si hay un enemigo en esa casilla.
        """
        pieza = cuadricula[fila][columna]
        return pieza is not None and pieza.jugador != self.jugador  # Devuelve un valor y termina la función

    def _es_aliado(self, cuadricula: list, fila: int, columna: int) -> bool:  # Define una función o método
        """
        Indica si la casilla contiene una pieza aliada.

        Args:
            cuadricula (list): Cuadrícula actual del tablero.
            fila       (int) : Fila a verificar.
            columna    (int) : Columna a verificar.

        Returns:
            bool: True si hay un aliado en esa casilla.
        """
        pieza = cuadricula[fila][columna]
        return pieza is not None and pieza.jugador == self.jugador  # Devuelve un valor y termina la función

    def _expandir_linea(  # Define una función o método
        self,
        cuadricula: list,
        deltaFila: int,
        deltaCol: int,
    ) -> list[tuple[int, int]]:
        """
        Genera movimientos en línea recta o diagonal hasta encontrar
        un obstáculo o el borde del tablero.

        Args:
            cuadricula (list): Estado actual del tablero.
            deltaFila  (int) : Incremento de fila por paso.
            deltaCol   (int) : Incremento de columna por paso.

        Returns:
            list[tuple[int,int]]: Lista de casillas alcanzables.
        """
        movimientos = []
        f, c = self.fila + deltaFila, self.columna + deltaCol
        while self._dentro_tablero(f, c):  # Repite el bloque mientras la condición sea verdadera
            if self._es_aliado(cuadricula, f, c):  # Evalúa una condición; ejecuta el bloque si es verdadera
                break  # Sale inmediatamente del bucle actual
            movimientos.append((f, c))
            if self._es_enemigo(cuadricula, f, c):  # Evalúa una condición; ejecuta el bloque si es verdadera
                break  # Sale inmediatamente del bucle actual
            f += deltaFila
            c += deltaCol
        return movimientos  # Devuelve un valor y termina la función

    # ------------------------------------------------------------------
    # Interfaz a sobreescribir
    # ------------------------------------------------------------------

    def movimientos_validos(self, cuadricula: list) -> list[tuple[int, int]]:  # Define una función o método
        """
        Calcula los movimientos legales de la pieza en el estado actual.

        Args:
            cuadricula (list): Cuadrícula 8x8 con objetos Pieza o None.

        Returns:
            list[tuple[int,int]]: Casillas adonde puede moverse.
        """
        return []  # Devuelve un valor y termina la función

    def serializar(self) -> dict:  # Define una función o método
        """
        Convierte la pieza a un diccionario JSON-serializable.

        Returns:
            dict: Representación serializable de la pieza.
        """
        return {  # Devuelve un valor y termina la función
            "tipo":    self.tipo,
            "jugador": self.jugador,
            "fila":    self.fila,
            "columna": self.columna,
            "movida":  self.movida,
            "energia": self.energia,
        }

    def __repr__(self) -> str:  # Define cómo se representa el objeto como texto
        """
        Representacion en cadena de la pieza para depuracion.

        Returns:
            str: Cadena con tipo, jugador y posicion.
        """
        return f"{self.tipo}({self.jugador},{self.fila},{self.columna})"  # Devuelve un valor y termina la función


