class Guardian(Pieza):  # Define una clase (plantilla para crear objetos)
    """
    Guardian — objetivo principal; equivale al Rey.

    Movimiento: una casilla en cualquier dirección.
    Restricción: no puede moverse a casillas amenazadas por el enemigo.
    Victoria: si el Guardian es capturado, el rival gana.
    """

    def __init__(self, jugador: str, fila: int, columna: int) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa el Guardian en la posicion indicada.

        Args:
            jugador (str): Propietario de la pieza.
            fila    (int): Fila inicial.
            columna (int): Columna inicial.
        """
        super().__init__(GUARDIAN, jugador, fila, columna)

    def _casillas_amenazadas_por_enemigo(self, cuadricula: list) -> set:  # Define una función o método
        """
        Calcula todas las casillas que las piezas enemigas pueden atacar.

        Se usa un tablero temporal sin el Guardian para evitar que su
        propia presencia bloquee la visión de las piezas enemigas.

        Args:
            cuadricula (list): Estado actual del tablero.

        Returns:
            set: Conjunto de (fila, columna) amenazadas por el enemigo.
        """
        amenazadas = set()
        enemigo = JUGADOR_2 if self.jugador == JUGADOR_1 else JUGADOR_1

        # Tablero temporal sin el Guardian para no bloquear líneas enemigas
        cuadriculaTmp = [fila[:] for fila in cuadricula]
        cuadriculaTmp[self.fila][self.columna] = None

        for fi in range(FILAS):  # Repite el bloque por cada elemento del iterable
            for ci in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
                pieza = cuadriculaTmp[fi][ci]
                if pieza is None or pieza.jugador != enemigo:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    continue  # Salta a la siguiente iteración del bucle
                # RunePawn amenaza en diagonal (no en avance)
                if pieza.tipo == RUNE_PAWN:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    direccion = 1 if pieza.jugador == JUGADOR_1 else -1
                    for dc in [-1, 1]:  # Repite el bloque por cada elemento del iterable
                        fa = fi + direccion
                        ca = ci + dc
                        if 0 <= fa < FILAS and 0 <= ca < COLUMNAS:  # Evalúa una condición; ejecuta el bloque si es verdadera
                            amenazadas.add((fa, ca))
                else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                    for mov in pieza.movimientos_validos(cuadriculaTmp):  # Repite el bloque por cada elemento del iterable
                        amenazadas.add(mov)
        return amenazadas  # Devuelve un valor y termina la función

    def movimientos_validos(self, cuadricula: list) -> list[tuple[int, int]]:  # Define una función o método
        """
        Calcula las casillas seguras adonde puede moverse el Guardian.

        Filtra los candidatos eliminando las casillas amenazadas por
        piezas enemigas, impidiendo que el Guardian se mueva al peligro.

        Args:
            cuadricula (list): Estado actual del tablero.

        Returns:
            list[tuple[int,int]]: Casillas seguras alcanzables.
        """
        amenazadas = self._casillas_amenazadas_por_enemigo(cuadricula)
        candidatos = []
        for df in [-1, 0, 1]:  # Repite el bloque por cada elemento del iterable
            for dc in [-1, 0, 1]:  # Repite el bloque por cada elemento del iterable
                if df == 0 and dc == 0:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    continue  # Salta a la siguiente iteración del bucle
                f, c = self.fila + df, self.columna + dc
                if (self._dentro_tablero(f, c)  # Evalúa una condición; ejecuta el bloque si es verdadera
                        and not self._es_aliado(cuadricula, f, c)
                        and (f, c) not in amenazadas):
                    candidatos.append((f, c))
        return candidatos  # Devuelve un valor y termina la función


class Invoker(Pieza):  # Define una clase (plantilla para crear objetos)
    """
    Invoker — pieza más poderosa; equivale a la Reina.

    Movimiento: cualquier dirección, distancia libre.
    """

    def __init__(self, jugador: str, fila: int, columna: int) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa el Invoker en la posicion indicada.

        Args:
            jugador (str): Propietario de la pieza.
            fila    (int): Fila inicial.
            columna (int): Columna inicial.
        """
        super().__init__(INVOKER, jugador, fila, columna)

    def movimientos_validos(self, cuadricula: list) -> list[tuple[int, int]]:  # Define una función o método
        """
        Calcula todos los movimientos del Invoker (8 direcciones libres).

        Args:
            cuadricula (list): Estado actual del tablero.

        Returns:
            list[tuple[int,int]]: Casillas alcanzables.
        """
        movimientos = []
        for df in [-1, 0, 1]:  # Repite el bloque por cada elemento del iterable
            for dc in [-1, 0, 1]:  # Repite el bloque por cada elemento del iterable
                if df == 0 and dc == 0:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    continue  # Salta a la siguiente iteración del bucle
                movimientos.extend(self._expandir_linea(cuadricula, df, dc))
        return movimientos  # Devuelve un valor y termina la función


