class FichaTecnica:  # Define una clase (plantilla para crear objetos)
    """
    Pantalla informativa con el reglamento completo de Rune Wars.

    Attributes:
        ventana    (pygame.Surface): Ventana principal.
        fuentes    (dict)          : Fuentes precargadas.
        scrollY    (int)           : Desplazamiento vertical actual.
        maxScrollY (int)           : Desplazamiento máximo calculado.
    """

    def __init__(self, ventana: pygame.Surface, fuentes: dict) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa la pantalla de ficha técnica.

        Args:
            ventana (pygame.Surface): Ventana de Pygame.
            fuentes (dict)          : Diccionario de fuentes del juego.
        """
        self.ventana    = ventana
        self.fuentes    = fuentes
        self.scrollY    = 0
        self.maxScrollY = 0
        self._reloj     = pygame.time.Clock()

        # Calcular alto total del contenido
        self._calcular_alto_contenido()

    def _calcular_alto_contenido(self) -> None:  # Define una función o método
        """Calcula el desplazamiento máximo según el contenido total."""
        altoTotal = 80
        for seccion in _SECCIONES:  # Repite el bloque por cada elemento del iterable
            altoTotal += 50   # título
            altoTotal += len(seccion["cuerpo"]) * 28 + 20
        self.maxScrollY = max(0, altoTotal - ALTO_VENTANA + 60)

    def ejecutar(self) -> None:  # Define una función o método
        """
        Bucle principal de la pantalla de ficha técnica.

        Retorna cuando el jugador pulsa ESC o el botón Volver.
        """
        botonRect = pygame.Rect(ANCHO_VENTANA // 2 - 80, ALTO_VENTANA - 55, 160, 40)

        ejecutando = True
        while ejecutando:  # Repite el bloque mientras la condición sea verdadera
            self._reloj.tick(FPS)

            for evento in pygame.event.get():  # Repite el bloque por cada elemento del iterable
                if evento.type == pygame.QUIT:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    pygame.quit()
                    raise SystemExit  # Lanza una excepción de forma manual

                if evento.type == pygame.KEYDOWN:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    if evento.key == pygame.K_ESCAPE:  # Evalúa una condición; ejecuta el bloque si es verdadera
                        ejecutando = False
                    elif evento.key == pygame.K_DOWN:  # Condición alternativa si la anterior fue falsa
                        self.scrollY = min(self.scrollY + 30, self.maxScrollY)
                    elif evento.key == pygame.K_UP:  # Condición alternativa si la anterior fue falsa
                        self.scrollY = max(self.scrollY - 30, 0)

                if evento.type == pygame.MOUSEWHEEL:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self.scrollY = max(0, min(self.scrollY - evento.y * 20, self.maxScrollY))

                if evento.type == pygame.MOUSEBUTTONDOWN and evento.button == 1:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    if botonRect.collidepoint(evento.pos):  # Evalúa una condición; ejecuta el bloque si es verdadera
                        ejecutando = False

            self._dibujar(botonRect)
            pygame.display.flip()

    def _dibujar(self, botonRect: pygame.Rect) -> None:  # Define una función o método
        """
        Dibuja toda la pantalla de ficha técnica.

        Args:
            botonRect (pygame.Rect): Área del botón Volver.
        """
        self.ventana.fill(COLOR_FONDO)

        y = 30 - self.scrollY
        cx = ANCHO_VENTANA // 2

        for seccion in _SECCIONES:  # Repite el bloque por cada elemento del iterable
            if -60 < y < ALTO_VENTANA + 60:  # Evalúa una condición; ejecuta el bloque si es verdadera
                # Título de sección
                surfTitulo = self.fuentes["grande"].render(seccion["titulo"], True, COLOR_TITULO)
                self.ventana.blit(surfTitulo, (cx - surfTitulo.get_width() // 2, y))
                y += 40

                # Línea decorativa
                pygame.draw.line(
                    self.ventana, COLOR_BORDE_TABLERO,
                    (cx - 200, y), (cx + 200, y), 1
                )
                y += 10

                # Líneas del cuerpo
                for linea in seccion["cuerpo"]:  # Repite el bloque por cada elemento del iterable
                    surfLinea = self.fuentes["pequena"].render(f"  {linea}", True, COLOR_TEXTO)
                    self.ventana.blit(surfLinea, (cx - surfLinea.get_width() // 2, y))
                    y += 26
                y += 14
            else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                y += 50 + len(seccion["cuerpo"]) * 26 + 14

        # Botón Volver (fijo en la parte inferior)
        mouse = pygame.mouse.get_pos()
        colorBoton = COLOR_BOTON_HOVER if botonRect.collidepoint(mouse) else COLOR_BOTON
        pygame.draw.rect(self.ventana, colorBoton, botonRect, border_radius=8)
        pygame.draw.rect(self.ventana, COLOR_BOTON_BORDE, botonRect, 2, border_radius=8)
        surfBoton = self.fuentes["mediana"].render("← Volver", True, COLOR_TITULO)
        self.ventana.blit(
            surfBoton,
            (botonRect.centerx - surfBoton.get_width() // 2,
             botonRect.centery - surfBoton.get_height() // 2),
        )

        # Indicador de scroll
        if self.maxScrollY > 0:  # Evalúa una condición; ejecuta el bloque si es verdadera
            pct = self.scrollY / self.maxScrollY
            barH = max(40, int((ALTO_VENTANA / (ALTO_VENTANA + self.maxScrollY)) * ALTO_VENTANA))
            barY = int(pct * (ALTO_VENTANA - barH))
            pygame.draw.rect(
                self.ventana, COLOR_BORDE_TABLERO,
                (ANCHO_VENTANA - 8, barY, 6, barH), border_radius=3
            )


