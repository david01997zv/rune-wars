class _CampoTexto:  # Define una clase (plantilla para crear objetos)
    """
    Campo de entrada de texto de una línea para Pygame.

    Args:
        rect    (pygame.Rect): Área del campo.
        fuente  (pygame.Font): Fuente.
        maximo  (int)        : Longitud máxima de texto.
        placeholder (str)   : Texto fantasma cuando está vacío.
    """

    def __init__(  # Constructor: inicializa el objeto al crearlo
        self,
        rect: pygame.Rect,
        fuente,
        maximo: int = 40,
        placeholder: str = "",
    ):
        self.rect        = rect
        self.fuente      = fuente
        self.maximo      = maximo
        self.placeholder = placeholder
        self.texto       = ""
        self.activo      = False
        self._cursor_visible = True
        self._ultimo_parpadeo = time.time()

    def manejar_evento(self, evento: pygame.event.Event):  # Define una función o método
        """
        Procesa eventos de teclado y clic para el campo.

        Args:
            evento (pygame.event.Event): Evento de Pygame.
        """
        if evento.type == pygame.MOUSEBUTTONDOWN:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.activo = self.rect.collidepoint(evento.pos)

        if self.activo and evento.type == pygame.KEYDOWN:  # Evalúa una condición; ejecuta el bloque si es verdadera
            if evento.key == pygame.K_BACKSPACE:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.texto = self.texto[:-1]
            elif evento.key not in (pygame.K_RETURN, pygame.K_TAB):  # Condición alternativa si la anterior fue falsa
                if len(self.texto) < self.maximo:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self.texto += evento.unicode

    def dibujar(self, superficie: pygame.Surface):  # Define una función o método
        """
        Dibuja el campo en la superficie.

        Args:
            superficie (pygame.Surface): Destino.
        """
        color_borde = _LOBBY_COLOR_INPUT_ACT if self.activo else _LOBBY_COLOR_INPUT_BORDE
        pygame.draw.rect(superficie, _LOBBY_COLOR_INPUT_FONDO, self.rect, border_radius=6)
        pygame.draw.rect(superficie, color_borde, self.rect, 2, border_radius=6)

        # Texto o placeholder
        mostrar = self.texto if self.texto else self.placeholder
        color_txt = _LOBBY_COLOR_TEXTO if self.texto else _LOBBY_COLOR_TEXTO_DIM

        # Cursor parpadeante
        ahora = time.time()
        if ahora - self._ultimo_parpadeo > 0.5:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._cursor_visible = not self._cursor_visible
            self._ultimo_parpadeo = ahora

        texto_render = mostrar
        if self.activo and self._cursor_visible:  # Evalúa una condición; ejecuta el bloque si es verdadera
            texto_render = self.texto + "|"

        surf_txt = self.fuente.render(texto_render, True, color_txt)
        # Clip para no desbordar el campo
        area = self.rect.inflate(-12, -6)
        superficie.set_clip(area)
        superficie.blit(surf_txt, (area.x, area.y + (area.height - surf_txt.get_height()) // 2))
        superficie.set_clip(None)


