class Juego:  # Define una clase (plantilla para crear objetos)
    """
    Controlador principal del juego Rune Wars (local y en red).

    En modo local aplica los movimientos directamente al tablero.
    En modo red solo envia el movimiento al servidor; el estado
    autoritativo llega por callback y se aplica en procesar_cola_red().

    Attributes:
        ventana           (pygame.Surface) : Ventana principal de Pygame.
        tablero           (Tablero)        : Estado logico de la partida.
        renderizador      (Renderizador)   : Motor de dibujo.
        estadoPartida     (str)            : 'jugando' | 'game_over'.
        _reloj            (pygame.time.Clock): Reloj de frames.
        _modo_red         (bool)           : True si la partida es en red.
        _es_servidor      (bool)           : True si este proceso es el servidor.
        _jugador_local_id (str)            : ID del jugador local en modo red.
        _pieza_origen_red (tuple|None)     : Origen del primer click en modo red.
        _cola_eventos_red (list)           : Cola thread-safe para eventos de red.
    """

    def __init__(self, ventana: pygame.Surface) -> None:  # Constructor: inicializa el objeto al crearlo
        """
        Inicializa el controlador del juego.

        Args:
            ventana (pygame.Surface): Ventana principal de Pygame.
        """
        self.ventana       = ventana
        self.tablero       = Tablero()
        self.renderizador  = Renderizador(ventana)
        self.estadoPartida = "jugando"
        self._reloj        = pygame.time.Clock()
        self._modo_red     = False
        self._es_servidor  = False
        self._jugador_local_id: str = JUGADOR_1
        self._pieza_origen_red: tuple | None = None
        self._cola_eventos_red: list = []
        self._modo_pc: bool = False
        self._pc: PCRuneWars | None = None
        self._pc_pensando: bool = False
        self._pc_delay: float = 0.0   # marca de tiempo para introducir pausa antes de mover

    # ------------------------------------------------------------------
    # Bucle principal
    # ------------------------------------------------------------------

    def activar_modo_pc(self, profundidad: int = 2) -> None:  # Define una función o método
        """
        Activa el modo de juego contra la PC.

        La PC siempre juega como JUGADOR_2.

        Args:
            profundidad (int): Nivel de dificultad (2=normal, 3=difícil).
        """
        self._modo_pc = True
        self._pc      = PCRuneWars(profundidad=profundidad)

    def ejecutar_local(self) -> str:  # Define una función o método
        """
        Inicia y ejecuta el bucle de juego hasta que termine la partida.

        Funciona tanto en modo local como en red; la diferencia esta
        en como se procesan los clicks del mouse.

        Returns:
            str: 'menu' para volver al menu, 'salir' para cerrar la app.
        """
        if not self._modo_red:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._reiniciar()

        ejecutando = True
        while ejecutando:  # Repite el bloque mientras la condición sea verdadera
            self._reloj.tick(FPS)
            self.procesar_cola_red()

            # Turno de la PC
            if (self._modo_pc  # Evalúa una condición; ejecuta el bloque si es verdadera
                    and self.estadoPartida == "jugando"
                    and self.tablero.estado.get("jugador_activo") == JUGADOR_2
                    and not self._pc_pensando):
                self._pc_pensando = True
                self._pc_delay    = time.time()

            if (self._modo_pc  # Evalúa una condición; ejecuta el bloque si es verdadera
                    and self._pc_pensando
                    and self.estadoPartida == "jugando"
                    and time.time() - self._pc_delay >= 0.4):
                self._pc_pensando = False
                self._manejar_turno_pc()

            for evento in pygame.event.get():  # Repite el bloque por cada elemento del iterable
                if evento.type == pygame.QUIT:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    return "salir"  # Devuelve un valor y termina la función

                if evento.type == pygame.KEYDOWN:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    if evento.key == pygame.K_ESCAPE:  # Evalúa una condición; ejecuta el bloque si es verdadera
                        if self.estadoPartida == "jugando" and not self._modo_red:
                            # Pedir confirmación antes de abandonar partida local activa
                            if self._confirmar_salida():
                                return "menu"  # Devuelve un valor y termina la función
                        else:
                            if self._modo_red:  # Evalúa una condición; ejecuta el bloque si es verdadera
                                self._rendirse()
                                self._desconectar_red()
                            return "menu"  # Devuelve un valor y termina la función
                    if evento.key == pygame.K_r and self.estadoPartida == "game_over":  # Evalúa una condición; ejecuta el bloque si es verdadera
                        if not self._modo_red:  # Evalúa una condición; ejecuta el bloque si es verdadera
                            self._reiniciar()
                            self._pc_pensando = False
                            self._pc_delay    = 0.0

                if evento.type == pygame.MOUSEBUTTONDOWN and evento.button == 1:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    if self.estadoPartida == "jugando":  # Evalúa una condición; ejecuta el bloque si es verdadera
                        # En modo PC solo el humano (JUGADOR_1) puede clickear
                        if self._modo_pc:  # Evalúa una condición; ejecuta el bloque si es verdadera
                            if self.tablero.estado.get("jugador_activo") == JUGADOR_1:  # Evalúa una condición; ejecuta el bloque si es verdadera
                                self._manejar_click_local(evento.pos)
                        elif self._modo_red:  # Condición alternativa si la anterior fue falsa
                            self._manejar_click_red(evento.pos)
                        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                            self._manejar_click_local(evento.pos)

            # Dibujar
            self.renderizador.dibujar_todo(self.tablero)

            if self.estadoPartida == "game_over":  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.renderizador.mostrar_pantalla_victoria(
                    self.tablero.ganador, self.tablero.razon
                )

            # Indicador de turno en modo red
            if self._modo_red and self.estadoPartida == "jugando":  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._dibujar_indicador_turno_red()

            # Indicador de turno en modo PC
            if self._modo_pc and self.estadoPartida == "jugando":  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._dibujar_indicador_turno_pc()

            pygame.display.flip()

        return "menu"  # Devuelve un valor y termina la función

    def _manejar_turno_pc(self) -> None:  # Define una función o método
        """
        Pide a la PC el mejor movimiento y lo aplica en el tablero.

        Solo se invoca cuando es turno de JUGADOR_2 en modo PC.
        Valida que la selección haya sido exitosa antes de intentar mover
        para evitar movimientos ilegales cuando la pieza de origen ya no
        pertenece a JUGADOR_2 o el turno cambió inesperadamente.
        """
        if self._pc is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return  # Devuelve un valor y termina la función

        # Guardia extra: asegurar que realmente sea turno de la PC
        if self.tablero.estado.get("jugador_activo") != JUGADOR_2:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return  # Devuelve un valor y termina la función

        movimiento = self._pc.elegir_movimiento(self.tablero)
        if movimiento is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return  # Devuelve un valor y termina la función

        origen, destino = movimiento

        # seleccionar_pieza retorna False si la pieza no pertenece al jugador activo
        seleccionOk = self.tablero.seleccionar_pieza(origen[0], origen[1])
        if not seleccionOk:  # Evalúa una condición; ejecuta el bloque si es verdadera
            # La pieza ya no existe o no pertenece a JUGADOR_2; abortar turno
            self.tablero.pieza_sel  = None
            self.tablero.highlights = {}
            return  # Devuelve un valor y termina la función

        # Verificar que el destino esté en los highlights generados
        if destino not in self.tablero.highlights:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.tablero.pieza_sel  = None
            self.tablero.highlights = {}
            return  # Devuelve un valor y termina la función

        self.tablero.mover_pieza(destino[0], destino[1])
        if self.tablero.ganador is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.estadoPartida = "game_over"

    def _dibujar_indicador_turno_pc(self) -> None:  # Define una función o método
        """
        Muestra en pantalla si es el turno del jugador humano o de la PC.
        """
        jugadorActivo = self.tablero.estado.get("jugador_activo")
        if jugadorActivo == JUGADOR_1:  # Evalúa una condición; ejecuta el bloque si es verdadera
            texto = "► Tu turno"
            color = COLOR_J1
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            texto = "🤖 PC pensando…"
            color = COLOR_J2
        self.renderizador.mostrar_notificacion(texto)

    # ------------------------------------------------------------------
    # Manejo de clicks — Modo local
    # ------------------------------------------------------------------

    def _manejar_click_local(self, posicion: tuple) -> None:  # Define una función o método
        """
        Traduce el click del mouse a coordenadas del tablero y lo procesa
        en modo local (sin red).

        Args:
            posicion (tuple): (x, y) del click en pixeles.
        """
        fila, col = self._pixel_a_celda(posicion)
        if fila is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.tablero.pieza_sel  = None
            self.tablero.highlights = {}
            return  # Devuelve un valor y termina la función

        if self.tablero.pieza_sel is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.tablero.seleccionar_pieza(fila, col)
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            movido = self.tablero.mover_pieza(fila, col)
            if not movido:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.tablero.seleccionar_pieza(fila, col)

        if self.tablero.ganador is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.estadoPartida = "game_over"

    # ------------------------------------------------------------------
    # Manejo de clicks — Modo red
    # ------------------------------------------------------------------

    def _manejar_click_red(self, posicion: tuple) -> None:  # Define una función o método
        """
        Maneja clicks en modo red.

        Solo permite interactuar cuando es el turno del jugador local.
        El primer click selecciona el origen; el segundo envia el
        movimiento al servidor (o al tablero autoritativo si es servidor).

        Args:
            posicion (tuple): (x, y) del click en pixeles.
        """
        # Bloquear si el jugador_id aún no fue confirmado por el servidor (sala_lista)
        if not getattr(self, "_jugador_id_confirmado", False):
            return  # Devuelve un valor y termina la función

        # Bloquear si no es el turno del jugador local
        jugadorActivo = self.tablero.estado.get("jugador_activo")
        if jugadorActivo != self._jugador_local_id:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return  # Devuelve un valor y termina la función

        fila, col = self._pixel_a_celda(posicion)
        if fila is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            # Click fuera del tablero: cancelar seleccion
            self._pieza_origen_red = None
            self.tablero.pieza_sel  = None
            self.tablero.highlights = {}
            return  # Devuelve un valor y termina la función

        if self._pieza_origen_red is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            # Primer click: intentar seleccionar pieza propia
            seleccionado = self.tablero.seleccionar_pieza(fila, col)
            if seleccionado:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._pieza_origen_red = (fila, col)
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            origen  = self._pieza_origen_red
            destino = (fila, col)
            self._pieza_origen_red = None

            # Verificar que el destino sea un movimiento/ataque valido
            tipoHighlight = self.tablero.highlights.get(destino)
            if tipoHighlight in ("movimiento", "ataque"):  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._enviar_movimiento_red(origen, destino)
                # Limpiar highlights mientras esperamos confirmacion del servidor
                self.tablero.pieza_sel  = None
                self.tablero.highlights = {}
            else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                # No era destino valido: reseleccionar o deseleccionar
                self.tablero.seleccionar_pieza(fila, col)
                pieza = self.tablero.cuadricula[fila][col]
                if (pieza is not None  # Evalúa una condición; ejecuta el bloque si es verdadera
                        and pieza.jugador == self._jugador_local_id):
                    self._pieza_origen_red = (fila, col)

    def _enviar_movimiento_red(self, origen: tuple, destino: tuple) -> None:  # Define una función o método
        """
        Envia el movimiento al servidor (cliente) o lo aplica directamente
        si este proceso es el servidor.

        Args:
            origen  (tuple): (fila, col) de origen.
            destino (tuple): (fila, col) de destino.
        """
        if self._es_servidor:  # Evalúa una condición; ejecuta el bloque si es verdadera
            # El servidor aplica el movimiento directamente en su tablero
            self.tablero.seleccionar_pieza(origen[0], origen[1])
            resultado = self.tablero.intentar_movimiento(destino[0], destino[1])
            if resultado.get("victoria"):  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.estadoPartida = "game_over"
            # Difundir el nuevo estado al cliente via callback del servidor
            if hasattr(self, "_servidorRed") and self._servidorRed is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                estadoSerial = serializar_estado(self.tablero)
                ultimoMov    = {"origen": list(origen), "destino": list(destino)}
                self._servidorRed._difundir(msg_actualizar(estadoSerial, ultimoMov))
                if resultado.get("victoria"):  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self._servidorRed._difundir(
                        msg_victoria(resultado["ganador"], resultado["razon"])
                    )
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            # El cliente envia el movimiento al servidor
            if hasattr(self, "_clienteRed") and self._clienteRed is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self._clienteRed.enviar_movimiento(origen, destino)

    # ------------------------------------------------------------------
    # Indicador visual de turno en red
    # ------------------------------------------------------------------

    def _dibujar_indicador_turno_red(self) -> None:  # Define una función o método
        """
        Dibuja un aviso en pantalla indicando si es el turno del jugador
        local o si debe esperar al rival.
        """
        jugadorActivo = self.tablero.estado.get("jugador_activo")
        esMiTurno = (jugadorActivo == self._jugador_local_id)
        texto  = "► Tu turno" if esMiTurno else "⏳ Turno del rival…"
        color  = COLOR_J1 if self._jugador_local_id == JUGADOR_1 else COLOR_J2
        if not esMiTurno:  # Evalúa una condición; ejecuta el bloque si es verdadera
            color = (150, 130, 180)
        self.renderizador.mostrar_notificacion(texto)

    # ------------------------------------------------------------------
    # Red — configuracion y callbacks
    # ------------------------------------------------------------------

    def configurar_red(self, clienteOServidor, esServidor: bool) -> None:  # Define una función o método
        """
        Activa el modo red en el Juego y registra los callbacks.

        Args:
            clienteOServidor: Instancia de Cliente o Servidor.
            esServidor (bool): True si este proceso es el servidor.
        """
        self._modo_red    = True
        self._es_servidor = esServidor

        if esServidor:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._servidorRed = clienteOServidor
            self._jugador_local_id = JUGADOR_1   # el servidor siempre es J1
            self._jugador_id_confirmado = True   # el servidor conoce su rol desde el inicio
            self._servidorRed.en_callback_estado = self._on_evento_servidor
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            self._clienteRed = clienteOServidor
            # El jugador_id real llega en el callback en_sala_lista del cliente
            self._jugador_local_id = self._clienteRed.jugador_id or JUGADOR_2
            self._jugador_id_confirmado = False  # se confirma al recibir sala_lista
            self._clienteRed.en_actualizar  = self._on_actualizar_cliente
            self._clienteRed.en_victoria    = self._on_victoria_cliente
            self._clienteRed.en_error       = self._on_error_cliente
            self._clienteRed.en_sala_lista  = self._on_sala_lista_cliente

    def procesar_cola_red(self) -> None:  # Define una función o método
        """
        Procesa los eventos de red pendientes en el hilo principal de Pygame.

        Debe llamarse una vez por frame antes de dibujar.
        """
        while self._cola_eventos_red:  # Repite el bloque mientras la condición sea verdadera
            item = self._cola_eventos_red.pop(0)
            tipoEvento = item[0]

            if tipoEvento == "actualizar":  # Evalúa una condición; ejecuta el bloque si es verdadera
                _, estado, _ = item
                self.tablero.aplicar_estado_serial(estado)
            elif tipoEvento == "victoria":  # Condición alternativa si la anterior fue falsa
                _, ganador, razon = item
                self.tablero.ganador = ganador
                self.tablero.razon   = razon
                self.estadoPartida   = "game_over"
            elif tipoEvento == "error":  # Condición alternativa si la anterior fue falsa
                _, descripcion = item
                self.renderizador.mostrar_notificacion(f"Red: {descripcion}")
            elif tipoEvento == "sala_lista":  # Condición alternativa si la anterior fue falsa
                _, jugadorId, _ = item
                self._jugador_local_id      = jugadorId
                self._jugador_id_confirmado = True  # ahora sí se permite interactuar

    def _on_sala_lista_cliente(self, jugadorId: str, rivalNombre: str) -> None:  # Define una función o método
        """
        Callback del cliente al confirmar su rol en la sala.

        Actualiza el ID del jugador local para que los bloqueos de turno
        funcionen correctamente.

        Args:
            jugadorId   (str): ID asignado por el servidor ('jugador_1/2').
            rivalNombre (str): Nombre del oponente.
        """
        self._cola_eventos_red.append(("sala_lista", jugadorId, rivalNombre))

    def _on_actualizar_cliente(self, estado: dict, ultimoMov: dict) -> None:  # Define una función o método
        """
        Callback del cliente al recibir un estado actualizado del servidor.

        Args:
            estado    (dict): Estado serializado del tablero.
            ultimoMov (dict): Ultimo movimiento ejecutado.
        """
        self._cola_eventos_red.append(("actualizar", estado, ultimoMov))

    def _on_victoria_cliente(self, ganador: str, razon: str) -> None:  # Define una función o método
        """
        Callback del cliente al recibir la senal de victoria.

        Args:
            ganador (str): Jugador ganador.
            razon   (str): Descripcion de la condicion.
        """
        self._cola_eventos_red.append(("victoria", ganador, razon))

    def _on_error_cliente(self, descripcion: str) -> None:  # Define una función o método
        """
        Callback del cliente ante un error de red.

        Args:
            descripcion (str): Descripcion del error.
        """
        self._cola_eventos_red.append(("error", descripcion))

    def _on_evento_servidor(self, evento: dict) -> None:  # Define una función o método
        """
        Callback del servidor para notificar eventos a la UI del anfitrion.

        Args:
            evento (dict): Diccionario con el tipo de evento.
        """
        tipo = evento.get("evento")
        if tipo == "actualizar":  # Evalúa una condición; ejecuta el bloque si es verdadera
            # El cliente hizo un movimiento; el estado ya viene serializado en el evento
            estado = evento.get("estado", {})
            ultimoMov = evento.get("ultimo_movimiento", {})
            self._cola_eventos_red.append(("actualizar", estado, ultimoMov))
        elif tipo == "victoria":  # Condición alternativa si la anterior fue falsa
            self._cola_eventos_red.append(
                ("victoria", evento.get("ganador", "?"), evento.get("razon", ""))
            )
        elif tipo == "desconexion":  # Condición alternativa si la anterior fue falsa
            self._cola_eventos_red.append(("error", "El rival se desconecto."))

    # ------------------------------------------------------------------
    # Utilidades
    # ------------------------------------------------------------------

    def _pixel_a_celda(self, posicion: tuple) -> tuple:  # Define una función o método
        """
        Convierte coordenadas de pixel a (fila, columna) del tablero.

        Args:
            posicion (tuple): (x, y) del click en pixeles.

        Returns:
            tuple: (fila, col) si esta dentro del tablero, (None, None) si no.
        """
        x, y = posicion
        col  = (x - OFFSET_X) // TAMANO_CELDA
        fila = (y - OFFSET_Y) // TAMANO_CELDA
        if 0 <= fila < FILAS and 0 <= col < COLUMNAS:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return fila, col  # Devuelve un valor y termina la función
        return None, None  # Devuelve un valor y termina la función

    def _rendirse(self) -> None:  # Define una función o método
        """Envia renuncia al servidor si el juego esta en curso en modo red."""
        if (self._modo_red  # Evalúa una condición; ejecuta el bloque si es verdadera
                and not self._es_servidor
                and self.estadoPartida == "jugando"
                and hasattr(self, "_clienteRed")):
            self._clienteRed.rendirse()

    def _desconectar_red(self) -> None:
        """
        Cierra limpiamente la conexión de red al salir, independientemente
        del estado de la partida (jugando o game_over).
        """
        if not self._modo_red:  # Solo aplica en modo red
            return
        try:
            if self._es_servidor and hasattr(self, "_servidorRed"):
                self._servidorRed.cerrar()
            elif not self._es_servidor and hasattr(self, "_clienteRed"):
                # Enviar renuncia solo si la partida aún estaba activa
                if self.estadoPartida == "jugando":
                    self._clienteRed.rendirse()
                self._clienteRed.desconectar()
        except Exception:
            pass  # Ignorar errores al cerrar; ya se está saliendo

    def _confirmar_salida(self) -> bool:
        """
        Muestra un diálogo de confirmación antes de abandonar una partida local activa.

        Dibuja un overlay con los botones Sí / No y espera la decisión del usuario.

        Returns:
            bool: True si el jugador confirma que desea salir, False si cancela.
        """
        overlay = pygame.Surface((ANCHO_VENTANA, ALTO_VENTANA), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 160))

        cx = ANCHO_VENTANA // 2
        cy = ALTO_VENTANA  // 2

        cajaRect  = pygame.Rect(cx - 200, cy - 90, 400, 180)
        btnSi     = pygame.Rect(cx - 110, cy + 30, 100, 38)
        btnNo     = pygame.Rect(cx + 10,  cy + 30, 100, 38)
        fuentes   = self.renderizador.fuentes

        reloj = pygame.time.Clock()
        while True:  # Esperar decisión del usuario
            reloj.tick(60)
            mouse = pygame.mouse.get_pos()

            for ev in pygame.event.get():
                if ev.type == pygame.QUIT:
                    return True  # Cerrar la aplicación también es confirmar salida
                if ev.type == pygame.KEYDOWN:
                    if ev.key == pygame.K_RETURN or ev.key == pygame.K_y:
                        return True
                    if ev.key == pygame.K_ESCAPE or ev.key == pygame.K_n:
                        return False
                if ev.type == pygame.MOUSEBUTTONDOWN and ev.button == 1:
                    if btnSi.collidepoint(ev.pos):
                        return True
                    if btnNo.collidepoint(ev.pos):
                        return False

            # Redibujar el juego de fondo + overlay
            self.renderizador.dibujar_todo(self.tablero)
            self.ventana.blit(overlay, (0, 0))

            pygame.draw.rect(self.ventana, (20, 15, 45), cajaRect, border_radius=14)
            pygame.draw.rect(self.ventana, COLOR_BORDE_TABLERO, cajaRect, 2, border_radius=14)

            surfMsg = fuentes["mediana"].render("¿Abandonar la partida?", True, COLOR_TITULO)
            self.ventana.blit(surfMsg, (cx - surfMsg.get_width() // 2, cy - 60))

            surfSub = fuentes["pequena"].render("Se perderá el progreso actual.", True, COLOR_TEXTO_DIM)
            self.ventana.blit(surfSub, (cx - surfSub.get_width() // 2, cy - 20))

            # Botón Sí
            colorSi = COLOR_BOTON_HOVER if btnSi.collidepoint(mouse) else COLOR_BOTON
            pygame.draw.rect(self.ventana, colorSi, btnSi, border_radius=8)
            pygame.draw.rect(self.ventana, COLOR_BOTON_BORDE, btnSi, 2, border_radius=8)
            surfSi = fuentes["mediana"].render("Sí", True, COLOR_TITULO)
            self.ventana.blit(surfSi, (btnSi.centerx - surfSi.get_width() // 2,
                                       btnSi.centery - surfSi.get_height() // 2))

            # Botón No
            colorNo = COLOR_BOTON_HOVER if btnNo.collidepoint(mouse) else COLOR_BOTON
            pygame.draw.rect(self.ventana, colorNo, btnNo, border_radius=8)
            pygame.draw.rect(self.ventana, COLOR_BOTON_BORDE, btnNo, 2, border_radius=8)
            surfNo = fuentes["mediana"].render("No", True, COLOR_TITULO)
            self.ventana.blit(surfNo, (btnNo.centerx - surfNo.get_width() // 2,
                                       btnNo.centery - surfNo.get_height() // 2))

            pygame.display.flip()

    def _reiniciar(self) -> None:  # Define una función o método
        """Reinicia el tablero y el estado de la partida a su posicion inicial."""
        self.tablero         = Tablero()
        self.estadoPartida   = "jugando"
        self._pc_pensando    = False
        self._pc_delay       = 0.0


