class Tablero:  # Define una clase (plantilla para crear objetos)
    """
    Controla el estado lógico de la partida de Rune Wars.

    Attributes:
        cuadricula  (list)      : Matriz 8x8 de Pieza | None.
        estado      (dict)      : Contador de turno, energías, capturas, etc.
        pieza_sel   (Pieza|None): Pieza seleccionada actualmente.
        highlights  (dict)      : {(f,c): tipo_highlight} para la UI.
        ganador     (str|None)  : Jugador ganador si la partida terminó.
        razon       (str)       : Descripción de la condición de victoria.
    """

    def __init__(self) -> None:  # Constructor: inicializa el objeto al crearlo
        """Inicializa el tablero y coloca las piezas en posición inicial."""
        self.cuadricula: list[list[Pieza | None]] = [
            [None] * COLUMNAS for _ in range(FILAS)
        ]
        self.estado: dict = {
            "jugador_activo":     JUGADOR_1,
            "capturas_j1":        0,
            "capturas_j2":        0,
            "energia_j1":         0,
            "energia_j2":         0,
            "turno_numero":       1,
            "guardian_capturado": None,
        }
        self.pieza_sel: Pieza | None = None
        self.highlights: dict        = {}
        self.ganador:    str | None  = None
        self.razon:      str         = ""

        self._colocar_piezas_iniciales()

    # ------------------------------------------------------------------
    # Inicialización
    # ------------------------------------------------------------------

    def _colocar_piezas_iniciales(self) -> None:  # Define una función o método
        """
        Coloca las piezas en sus posiciones de inicio para ambos jugadores.

        Jugador 2 ocupa las filas 0-1; Jugador 1 las filas 6-7.
        """
        for col, tipo in enumerate(ORDEN_FILA_ATRAS):  # Repite el bloque por cada elemento del iterable
            self.cuadricula[0][col] = crear_pieza(tipo, JUGADOR_2, 0, col)
        for col in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
            self.cuadricula[1][col] = crear_pieza(RUNE_PAWN, JUGADOR_2, 1, col)

        for col in range(COLUMNAS):  # Repite el bloque por cada elemento del iterable
            self.cuadricula[6][col] = crear_pieza(RUNE_PAWN, JUGADOR_1, 6, col)
        for col, tipo in enumerate(ORDEN_FILA_ATRAS):  # Repite el bloque por cada elemento del iterable
            self.cuadricula[7][col] = crear_pieza(tipo, JUGADOR_1, 7, col)

    # ------------------------------------------------------------------
    # Selección y movimiento
    # ------------------------------------------------------------------

    def seleccionar_pieza(self, fila: int, columna: int) -> bool:  # Define una función o método
        """
        Selecciona la pieza en (fila, columna) si pertenece al jugador activo.

        Calcula y almacena en self.highlights los movimientos válidos.
        Si el jugador tiene energía máxima, activa la habilidad de runa:
        los movimientos lineales ignoran aliados bloqueantes.
        Si se pulsa una casilla vacía o pieza enemiga, deselecciona la actual.

        Args:
            fila    (int): Fila de la casilla pulsada.
            columna (int): Columna de la casilla pulsada.

        Returns:
            bool: True si se seleccionó una pieza válida.
        """
        pieza = self.cuadricula[fila][columna]
        if pieza is None or pieza.jugador != self.estado["jugador_activo"]:  # Evalúa una condición; ejecuta el bloque si es verdadera
            # Deseleccionar si se pulsa casilla vacía o enemiga
            self.pieza_sel  = None
            self.highlights = {}
            return False  # Devuelve un valor y termina la función

        self.pieza_sel = pieza

        # Verificar si el jugador activo tiene energía máxima (habilidad de runa)
        claveEnergia = "energia_j1" if pieza.jugador == JUGADOR_1 else "energia_j2"
        runaActiva   = self.estado.get(claveEnergia, 0) >= ENERGIA_MAX

        if runaActiva:
            # Con habilidad activa: obtener movimientos ampliados (ignoran aliados)
            movimientos = self._movimientos_con_runa(pieza)
        else:
            movimientos = pieza.movimientos_validos(self.cuadricula)

        self.highlights = {"sel": (fila, columna)}
        for f, c in movimientos:  # Repite el bloque por cada elemento del iterable
            if self.cuadricula[f][c] is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.highlights[(f, c)] = "ataque"
            else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                self.highlights[(f, c)] = "movimiento"
        return True  # Devuelve un valor y termina la función

    def _movimientos_con_runa(self, pieza: "Pieza") -> list:
        """
        Calcula movimientos ampliados cuando la habilidad de runa está activa.

        Las piezas de línea (Invoker, Lancer, Sentinel) pueden atravesar
        aliados. Las demás usan sus movimientos normales.

        Args:
            pieza (Pieza): Pieza seleccionada con energía máxima.

        Returns:
            list[tuple[int,int]]: Casillas alcanzables con la habilidad activa.
        """
        if pieza.tipo in (INVOKER, LANCER, SENTINEL):
            # Crear cuadrícula temporal sin aliados para simular el paso libre
            cuadriculaTmp = [fila[:] for fila in self.cuadricula]
            for fi in range(FILAS):
                for ci in range(COLUMNAS):
                    p = cuadriculaTmp[fi][ci]
                    if p is not None and p.jugador == pieza.jugador and (fi, ci) != (pieza.fila, pieza.columna):
                        cuadriculaTmp[fi][ci] = None  # Retirar aliados temporalmente
            return pieza.movimientos_validos(cuadriculaTmp)
        return pieza.movimientos_validos(self.cuadricula)

    def mover_pieza(self, destino_fila: int, destino_col: int) -> bool:  # Define una función o método
        """
        Ejecuta el movimiento de la pieza seleccionada al destino indicado.

        Valida que el destino sea un highlight de movimiento o ataque,
        aplica captura si corresponde, verifica victoria y cambia el turno.

        Args:
            destino_fila (int): Fila destino.
            destino_col  (int): Columna destino.

        Returns:
            bool: True si el movimiento se realizó con éxito.
        """
        if self.pieza_sel is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return False  # Devuelve un valor y termina la función

        # BUG FIX: verificar que el destino sea una casilla de movimiento/ataque,
        # no la clave especial "sel" que es un string.
        tipo_highlight = self.highlights.get((destino_fila, destino_col))
        if tipo_highlight not in ("movimiento", "ataque"):  # Evalúa una condición; ejecuta el bloque si es verdadera
            return False  # Devuelve un valor y termina la función

        pieza      = self.pieza_sel
        origenFila = pieza.fila
        origenCol  = pieza.columna
        capturada  = self.cuadricula[destino_fila][destino_col]

        # Verificar si la habilidad de runa estaba activa antes del movimiento
        claveEnergia = "energia_j1" if pieza.jugador == JUGADOR_1 else "energia_j2"
        runaUsada    = self.estado.get(claveEnergia, 0) >= ENERGIA_MAX

        # Aplicar captura
        if capturada is not None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._registrar_captura(capturada)
            if capturada.tipo == GUARDIAN:  # Evalúa una condición; ejecuta el bloque si es verdadera
                self.ganador = pieza.jugador
                self.razon   = "¡El Guardian enemigo ha caído!"

        # Mover pieza
        self.cuadricula[origenFila][origenCol]         = None
        self.cuadricula[destino_fila][destino_col]     = pieza
        pieza.fila    = destino_fila
        pieza.columna = destino_col
        pieza.movida  = True

        # Consumir energía de runa si la habilidad fue utilizada
        if runaUsada:
            self.estado[claveEnergia] = 0  # Resetear energía al usar la habilidad

        # Transformación de RunePawn
        self._verificar_transformacion(pieza, destino_fila, destino_col)

        # Limpiar selección
        self.pieza_sel  = None
        self.highlights = {}

        # Cambiar turno si no hubo victoria
        if self.ganador is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self._cambiar_turno()

        return True  # Devuelve un valor y termina la función

    def intentar_movimiento(self, fila_d: int, col_d: int) -> dict:  # Define una función o método
        """
        Intenta ejecutar el movimiento de la pieza ya seleccionada hacia (fila_d, col_d).

        Usado por el servidor de red para procesar movimientos recibidos
        sin necesidad de tener una pieza preseleccionada en la UI.

        El servidor debe llamar primero a seleccionar_pieza(fila_o, col_o),
        y luego a este método para ejecutar el movimiento.

        Args:
            fila_d (int): Fila destino.
            col_d  (int): Columna destino.

        Returns:
            dict: {
                "valido"   (bool): True si el movimiento fue ejecutado.
                "victoria" (bool): True si la partida terminó.
                "ganador"  (str|None): Jugador ganador o None.
                "razon"    (str): Descripción de la victoria.
            }
        """
        if self.pieza_sel is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return {"valido": False, "victoria": False, "ganador": None, "razon": ""}  # Devuelve un valor y termina la función

        ejecutado = self.mover_pieza(fila_d, col_d)
        if not ejecutado:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return {"valido": False, "victoria": False, "ganador": None, "razon": ""}  # Devuelve un valor y termina la función

        return {  # Devuelve un valor y termina la función
            "valido":   True,
            "victoria": self.ganador is not None,
            "ganador":  self.ganador,
            "razon":    self.razon,
        }

    # ------------------------------------------------------------------
    # Lógica interna de turno y estado
    # ------------------------------------------------------------------

    def _registrar_captura(self, pieza: Pieza) -> None:  # Define una función o método
        """
        Actualiza contadores de capturas y energía del jugador activo.

        Args:
            pieza (Pieza): Pieza que fue capturada.
        """
        jugador = self.estado["jugador_activo"]
        if jugador == JUGADOR_1:  # Evalúa una condición; ejecuta el bloque si es verdadera
            self.estado["capturas_j1"] += 1
            self.estado["energia_j1"]   = min(
                self.estado["energia_j1"] + ENERGIA_POR_CAPTURA, ENERGIA_MAX
            )
        else:  # Bloque que se ejecuta si ninguna condición fue verdadera
            self.estado["capturas_j2"] += 1
            self.estado["energia_j2"]   = min(
                self.estado["energia_j2"] + ENERGIA_POR_CAPTURA, ENERGIA_MAX
            )

    def _verificar_transformacion(self, pieza: Pieza, fila: int, columna: int) -> None:  # Define una función o método
        """
        Transforma un RunePawn en Invoker si alcanza la fila extrema rival.

        Args:
            pieza   (Pieza): Pieza recién movida.
            fila    (int)  : Fila de destino.
            columna (int)  : Columna de destino.
        """
        if pieza.tipo != RUNE_PAWN:  # Evalúa una condición; ejecuta el bloque si es verdadera
            return  # Devuelve un valor y termina la función
        filaTransf = 0 if pieza.jugador == JUGADOR_1 else FILAS - 1
        if fila == filaTransf:  # Evalúa una condición; ejecuta el bloque si es verdadera
            nuevoInvoker          = Invoker(pieza.jugador, fila, columna)
            nuevoInvoker.movida   = True
            self.cuadricula[fila][columna] = nuevoInvoker

    def _cambiar_turno(self) -> None:  # Define una función o método
        """Alterna el jugador activo e incrementa el contador de turnos."""
        actual = self.estado["jugador_activo"]
        self.estado["jugador_activo"] = (
            JUGADOR_2 if actual == JUGADOR_1 else JUGADOR_1
        )
        self.estado["turno_numero"] += 1

    # ------------------------------------------------------------------
    # Serialización para red
    # ------------------------------------------------------------------

    def serializar_estado(self) -> dict:  # Define una función o método
        """
        Convierte el estado del tablero a un diccionario JSON-serializable.

        Returns:
            dict: Estado completo serializable.
        """
        cuadricula_serial = []
        for fila in self.cuadricula:  # Repite el bloque por cada elemento del iterable
            fila_serial = []
            for pieza in fila:  # Repite el bloque por cada elemento del iterable
                fila_serial.append(pieza.serializar() if pieza else None)
            cuadricula_serial.append(fila_serial)

        return {  # Devuelve un valor y termina la función
            "cuadricula":         cuadricula_serial,
            "jugador_activo":     self.estado["jugador_activo"],
            "capturas_j1":        self.estado["capturas_j1"],
            "capturas_j2":        self.estado["capturas_j2"],
            "energia_j1":         self.estado["energia_j1"],
            "energia_j2":         self.estado["energia_j2"],
            "turno_numero":       self.estado["turno_numero"],
            "guardian_capturado": self.estado["guardian_capturado"],
        }

    def aplicar_estado_serial(self, estadoSerial: dict) -> None:  # Define una función o método
        """
        Reconstruye el tablero a partir de un estado serializado recibido por red.

        Args:
            estadoSerial (dict): Estado serializado (ver serializar_estado).
        """
        cuadricula_serial = estadoSerial.get("cuadricula", [])
        for fi, fila in enumerate(cuadricula_serial):  # Repite el bloque por cada elemento del iterable
            for ci, celda in enumerate(fila):  # Repite el bloque por cada elemento del iterable
                if celda is None:  # Evalúa una condición; ejecuta el bloque si es verdadera
                    self.cuadricula[fi][ci] = None
                else:  # Bloque que se ejecuta si ninguna condición fue verdadera
                    self.cuadricula[fi][ci] = crear_pieza(
                        celda["tipo"], celda["jugador"], fi, ci
                    )
                    p           = self.cuadricula[fi][ci]
                    p.movida    = celda.get("movida",  False)
                    p.energia   = celda.get("energia", 0)

        self.estado["jugador_activo"]     = estadoSerial.get("jugador_activo",     JUGADOR_1)
        self.estado["capturas_j1"]        = estadoSerial.get("capturas_j1",        0)
        self.estado["capturas_j2"]        = estadoSerial.get("capturas_j2",        0)
        self.estado["energia_j1"]         = estadoSerial.get("energia_j1",         0)
        self.estado["energia_j2"]         = estadoSerial.get("energia_j2",         0)
        self.estado["turno_numero"]       = estadoSerial.get("turno_numero",        1)
        self.estado["guardian_capturado"] = estadoSerial.get("guardian_capturado", None)

        self.pieza_sel  = None
        self.highlights = {}


